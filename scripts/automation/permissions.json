      "kind": "screenshot",
      "label": "08-permissions-audit"
    },
    {
      "kind": "click",
      "testid": "permissions-reload"
    },
    {
      "kind": "sleep",
      "ms": 600
    },
    {
      "kind": "screenshot",
      "label": "09-permissions-reloaded"
    },
    {
      "kind": "click",
      "testid": "permissions-revoke-all"
    },
    {
      "kind": "waitFor",
      "testid": "permissions-revoke-all-dialog",
      "timeoutMs": 8000
