{
  "name": "hitl",
  "stopOnError": false,
  "steps": [
    { "kind": "waitFor", "testid": "app-main", "timeoutMs": 30000 },
    { "kind": "goto", "route": "chat" },
    { "kind": "waitFor", "testid": "chat-input", "timeoutMs": 15000 },

    { "kind": "sendChat", "text": "Crée un fichier note.txt contenant le mot bonjour." },
    { "kind": "waitFor", "testid": "chat-approval-inline", "timeoutMs": 120000 },
    { "kind": "screenshot", "label": "01-approval-card" },
    { "kind": "click", "testidPrefix": "approval-accept-" },
    { "kind": "waitGone", "testid": "chat-stop-button", "timeoutMs": 120000 },
    { "kind": "screenshot", "label": "02-approval-accepted" },

    { "kind": "sendChat", "text": "Écris \"salut\" dans un fichier tmp/demo.txt." },
    { "kind": "waitFor", "testid": "hitl-fs-modal", "timeoutMs": 120000 },
    { "kind": "screenshot", "label": "03-fs-modal" },
    { "kind": "click", "testid": "hitl-fs-approve" },
    { "kind": "waitGone", "testid": "chat-stop-button", "timeoutMs": 120000 },
    { "kind": "screenshot", "label": "04-fs-approved" },

    { "kind": "sendChat", "text": "Avant de continuer, demande-moi mon prénom avec l'outil ask_user, puis répète-le." },
    { "kind": "waitFor", "testid": "chat-ask-user-inline", "timeoutMs": 120000 },
    { "kind": "screenshot", "label": "05-ask-user-card" },
    { "kind": "fill", "testidPrefix": "ask-user-input-", "text": "Nidal" },
    { "kind": "screenshot", "label": "06-ask-user-filled" },
    { "kind": "click", "testid": "ask-user-submit" },
    { "kind": "waitGone", "testid": "chat-stop-button", "timeoutMs": 120000 },
    { "kind": "captureText", "testidPrefix": "chat-message-", "nth": -1, "as": "ask_user_echo" },
    { "kind": "screenshot", "label": "07-ask-user-answered" }
  ]
}
