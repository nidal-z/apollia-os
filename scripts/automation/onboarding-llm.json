{
  "name": "onboarding-llm",
  "stopOnError": false,
  "dynamicTestids": [
    "profile-field-role"
  ],
  "steps": [
    {
      "kind": "waitFor",
      "testid": "onboarding-modal",
      "timeoutMs": 30000
    },
    {
      "kind": "waitFor",
      "testid": "onboarding-welcome"
    },
    {
      "kind": "click",
      "testid": "onboarding-welcome-cta"
    },
    {
      "kind": "waitFor",
      "testid": "onboarding-ai-setup",
      "timeoutMs": 15000
    },
    {
      "kind": "screenshot",
      "label": "01-onb-ai-setup"
    },
    {
      "kind": "waitFor",
      "testid": "llm-section",
      "timeoutMs": 20000
    },
    {
      "kind": "click",
      "testid": "ai-setup-continue",
      "timeoutMs": 6000
    },
    {
      "kind": "waitFor",
      "testid": "onboarding-embeddings",
      "timeoutMs": 15000
    },
    {
      "kind": "waitFor",
      "testid": "embeddings-skip",
      "timeoutMs": 15000
    },
    {
      "kind": "click",
      "testid": "embeddings-skip",
      "timeoutMs": 3000
    },
    {
      "kind": "waitFor",
      "testid": "embeddings-skip-warning",
      "timeoutMs": 6000
    },
    {
      "kind": "click",
      "testid": "embeddings-continue-without",
      "timeoutMs": 3000
    },
    {
      "kind": "waitFor",
      "testid": "onboarding-chat-step",
      "timeoutMs": 15000
    },
    {
      "kind": "waitFor",
      "testid": "onboarding-bootstrap",
      "timeoutMs": 30000
    },
    {
      "kind": "screenshot",
      "label": "02-onb-bootstrap"
    },
    {
      "kind": "waitFor",
      "testid": "chat-stop-button",
      "timeoutMs": 30000
    },
    {
      "kind": "screenshot",
      "label": "03-onb-bootstrap-streaming"
    },
    {
      "kind": "waitGone",
      "testid": "chat-stop-button",
      "timeoutMs": 120000
    },
    {
      "kind": "waitFor",
      "testid": "onboarding-chat-banner",
      "timeoutMs": 15000
    },
    {
      "kind": "screenshot",
      "label": "04-onb-chat-first-question"
    },
    {
      "kind": "sleep",
      "ms": 800
    },
    {
      "kind": "captureText",
      "testidPrefix": "chat-message-",
      "nth": -1,
      "as": "bootstrap_reply"
    },
    {
      "kind": "sendChat",
      "text": "My name is Nidal and I'm a software engineer."
    },
    {
      "kind": "waitFor",
      "testid": "chat-stop-button",
      "timeoutMs": 30000
    },
    {
      "kind": "screenshot",
      "label": "05-onb-name-role-during"
    },
    {
      "kind": "waitGone",
      "testid": "chat-stop-button",
      "timeoutMs": 120000
    },
    {
      "kind": "sleep",
      "ms": 800
    },
    {
      "kind": "captureText",
      "testidPrefix": "chat-message-",
      "nth": -1,
      "as": "answer_name_role"
    },
    {
      "kind": "screenshot",
      "label": "06-onb-pips-after-name"
    },
    {
      "kind": "sendChat",
      "text": "I work in the engineering department, with VS Code, GitHub and Slack."
    },
    {
      "kind": "waitFor",
      "testid": "chat-stop-button",
      "timeoutMs": 30000
    },
    {
      "kind": "waitGone",
      "testid": "chat-stop-button",
      "timeoutMs": 120000
    },
    {
      "kind": "sleep",
      "ms": 800
    },
    {
      "kind": "captureText",
      "testidPrefix": "chat-message-",
      "nth": -1,
      "as": "answer_function_tools"
    },
    {
      "kind": "screenshot",
      "label": "07-onb-pips-after-tools"
    },
    {
      "kind": "sendChat",
      "text": "I like short answers, in English."
    },
    {
      "kind": "waitFor",
      "testid": "chat-stop-button",
      "timeoutMs": 30000
    },
    {
      "kind": "waitGone",
      "testid": "chat-stop-button",
      "timeoutMs": 120000
    },
    {
      "kind": "sleep",
      "ms": 800
    },
    {
      "kind": "captureText",
      "testidPrefix": "chat-message-",
      "nth": -1,
      "as": "answer_preferences"
    },
    {
      "kind": "screenshot",
      "label": "08-onb-pips-after-preferences"
    },
    {
      "kind": "waitFor",
      "testid": "onboarding-finish-early",
      "timeoutMs": 30000
    },
    {
      "kind": "screenshot",
      "label": "09-onb-finish-early"
    },
    {
      "kind": "click",
      "testid": "onboarding-finish-early"
    },
    {
      "kind": "waitFor",
      "testid": "onboarding-profile-review",
      "timeoutMs": 180000
    },
    {
      "kind": "waitFor",
      "testid": "profile-field-role",
      "timeoutMs": 15000
    },
    {
      "kind": "screenshot",
      "label": "10-onb-profile-proposed"
    },
    {
      "kind": "fill",
      "testid": "profile-field-role",
      "text": "Staff software engineer"
    },
    {
      "kind": "expect",
      "testid": "onboarding-review-skip"
    },
    {
      "kind": "screenshot",
      "label": "11-onb-profile-role-corrected"
    },
    {
      "kind": "click",
      "testid": "onboarding-review-save",
      "timeoutMs": 3000
    },
    {
      "kind": "waitGone",
      "testid": "onboarding-modal",
      "timeoutMs": 15000
    },
    {
      "kind": "screenshot",
      "label": "12-onb-profile-saved"
    }
  ]
}
