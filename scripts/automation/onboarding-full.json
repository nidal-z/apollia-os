    {
      "kind": "sleep",
      "ms": 500
    },
    {
      "kind": "screenshot",
      "label": "08c-onb-stt-configured"
    },
    {
      "kind": "click",
      "testid": "ai-setup-continue",
      "timeoutMs": 6000
