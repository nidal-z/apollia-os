    },
    {
      "kind": "waitFor",
      "testid": "llm-section",
      "timeoutMs": 20000
    },
    {
      "kind": "expect",
      "testid": "stt-section"
    },
    {
      "kind": "expect",
      "testid": "stt-toggle"
    },
    {
      "kind": "screenshot",
      "label": "06-onb-ai-setup"
    },
    {
      "kind": "click",
      "testid": "ai-setup-back"
    },
    {
      "kind": "waitFor",
      "testid": "onboarding-profile-selector",
      "timeoutMs": 15000
    },
    {
      "kind": "screenshot",
      "label": "07-onb-ai-setup-back"
    },
    {
      "kind": "click",
      "testid": "profile-card-builder"
    },
    {
      "kind": "waitFor",
      "testid": "onboarding-ai-setup",
      "timeoutMs": 15000
    },
    {
      "kind": "screenshot",
      "label": "08-onb-ai-setup-builder"
    },
    {
      "kind": "waitFor",
      "testid": "llm-model-row",
      "timeoutMs": 8000
    },
    {
      "kind": "click",
      "testid": "llm-model-row",
      "timeoutMs": 3000
    },
    {
      "kind": "sleep",
      "ms": 1500
    },
    {
      "kind": "screenshot",
      "label": "08b-onb-llm-detected-row-picked"
    },
    {
      "kind": "setChecked",
      "testid": "stt-toggle",
      "checked": true
    },
    {
      "kind": "waitFor",
      "testid": "stt-hotkey-block",
      "timeoutMs": 6000
    },
    {
      "kind": "waitFor",
      "testid": "whisper-model-row",
