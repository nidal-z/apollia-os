      "timeoutMs": 3000
    },
    {
      "kind": "click",
      "testid": "stt-hotkey-capture",
      "timeoutMs": 3000
    },
    {
      "kind": "press",
      "testid": "stt-hotkey-capture",
      "key": "k",
      "meta": true,
      "shift": true,
      "timeoutMs": 3000
