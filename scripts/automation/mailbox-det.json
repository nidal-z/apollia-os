{
  "name": "mailbox-det (inter-agent mailbox observability surface; seeded mailbox.db, asserts populated rows on Observability > Mailbox)",
  "stopOnError": false,
  "notes": [
    "Observability is a developer screen: with the developer mode off the router sends the route to the default one (lib/navigation/developerRoutes.ts reachableRoute, applied in Main.svelte), so the book turns the mode on from the settings before it opens the screen, as observability-det does. The mailbox tab itself is one of the three tabs drawn for everyone once the screen is reached (routes/Observability.svelte tabItems)."
  ],
  "dynamicTestids": [
    "observability-tab-mailbox",
    "settings-nav-developer"
  ],
  "steps": [
    {
      "kind": "click",
      "testid": "onboarding-skip",
      "timeoutMs": 3000
    },
    {
      "kind": "waitGone",
      "testid": "onboarding-skip",
      "timeoutMs": 3000
    },
    {
      "kind": "waitFor",
      "testid": "app-main",
      "timeoutMs": 30000
    },
    {
      "kind": "goto",
      "route": "settings"
    },
    {
      "kind": "waitFor",
      "testid": "settings-page",
      "timeoutMs": 4000
    },
    {
      "kind": "click",
      "testid": "settings-nav-developer"
    },
    {
      "kind": "waitFor",
      "testid": "developer-mode-toggle",
      "timeoutMs": 4000
    },
    {
      "kind": "click",
      "testid": "developer-mode-on"
    },
    {
      "kind": "sleep",
      "ms": 800
    },
    {
      "kind": "goto",
      "route": "observability"
    },
    {
      "kind": "waitFor",
      "testid": "observability-page",
      "timeoutMs": 15000
    },
    {
      "kind": "screenshot",
      "label": "01-observability-page"
    },
    {
      "kind": "expect",
      "testid": "observability-tab-mailbox"
    },
    {
      "kind": "click",
      "testid": "observability-tab-mailbox"
    },
    {
      "kind": "sleep",
      "ms": 600
    },
    {
      "kind": "waitFor",
      "testid": "mailbox-list",
      "timeoutMs": 6000
    },
    {
      "kind": "screenshot",
      "label": "02-mailbox-list"
    },
    {
      "kind": "waitFor",
      "testid": "mailbox-message-row",
      "nth": 0,
      "timeoutMs": 4000
    },
    {
      "kind": "expect",
      "testid": "mailbox-message-from",
      "nth": 0
    },
    {
      "kind": "expect",
      "testid": "mailbox-message-to",
      "nth": 0
    },
    {
      "kind": "expect",
      "testid": "mailbox-message-payload",
      "nth": 0
    },
    {
      "kind": "expect",
      "testid": "mailbox-message-state",
      "nth": 0
    },
    {
      "kind": "captureText",
      "testid": "mailbox-message-from",
      "nth": 0,
      "as": "first-message-from"
    },
    {
      "kind": "captureText",
      "testid": "mailbox-message-payload",
      "nth": 0,
      "as": "first-message-payload"
    },
    {
      "kind": "screenshot",
      "label": "03-mailbox-first-row"
    }
  ]
}
