{
  "name": "agents-a2a-llm (A2A infra: worker chip + delegation best-effort)",
  "stopOnError": false,
  "steps": [
    {
      "kind": "click",
      "testid": "onboarding-skip",
      "timeoutMs": 8000
    },
    {
      "kind": "waitGone",
      "testid": "onboarding-skip",
      "timeoutMs": 5000
    },
    {
      "kind": "waitFor",
      "testid": "app-main"
    },
    {
      "kind": "goto",
      "route": "chat"
    },
    {
      "kind": "waitFor",
      "testid": "chat-page"
    },
    {
      "kind": "click",
      "testid": "chat-new-chat-btn"
    },
    {
      "kind": "waitFor",
      "testid": "quickpicker"
    },
    {
      "kind": "fill",
      "testid": "quickpicker-textarea",
      "text": "Bonjour, je vais te demander une classification."
    },
    {
      "kind": "click",
      "testid": "quickpicker-submit"
    },
    {
      "kind": "waitFor",
      "testid": "chat-input",
      "timeoutMs": 30000
    },
    {
      "kind": "awaitTurn",
      "timeoutMs": 120000
    },
    {
      "kind": "screenshot",
      "label": "01-chat-ready"
    },
    {
      "kind": "expect",
      "testid": "a2a-worker-badge"
    },
    {
      "kind": "click",
      "testid": "a2a-worker-badge"
    },
    {
      "kind": "waitFor",
      "testid": "a2a-worker-popover",
      "timeoutMs": 5000
    },
    {
      "kind": "expect",
      "testid": "a2a-skill-chip-classify_text"
    },
    {
      "kind": "screenshot",
      "label": "02-skill-chip-classify_text"
    },
    {
      "kind": "click",
      "testid": "a2a-worker-badge"
    },
    {
      "kind": "sleep",
      "ms": 400
    },
    {
      "kind": "sendChat",
      "text": "Utilise le worker seed-classifier via son skill classify_text pour classer le texte \"chaudiere gaz du site A\" parmi les labels [\"scope1\", \"scope2\", \"scope3\"]."
    },
    {
      "kind": "waitFor",
      "testid": "chat-stop-button",
      "timeoutMs": 30000
    },
    {
      "kind": "sleep",
      "ms": 500
    },
    {
      "kind": "screenshot",
      "label": "03-delegation-best-effort"
    },
    {
      "kind": "awaitTurn",
      "timeoutMs": 180000
    },
    {
      "kind": "sleep",
      "ms": 800
    },
    {
      "kind": "captureText",
      "testidPrefix": "chat-message-",
      "nth": -1,
      "as": "a2a_result"
    },
    {
      "kind": "screenshot",
      "label": "04-a2a-result"
    },
    {
      "kind": "goto",
      "route": "agents"
    },
    {
      "kind": "waitFor",
      "testid": "agents-list"
    },
    {
      "kind": "fill",
      "testid": "agents-search",
      "text": "seed-classifier"
    },
    {
      "kind": "sleep",
      "ms": 600
    },
    {
      "kind": "screenshot",
      "label": "05-worker-in-agents-list"
    }
  ]
}
