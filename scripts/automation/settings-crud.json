{
  "name": "settings-crud",
  "stopOnError": false,
  "steps": [
    { "kind": "waitFor", "testid": "app-main", "timeoutMs": 30000 },

    { "kind": "goto", "route": "settings" },
    { "kind": "waitFor", "testid": "settings-page", "timeoutMs": 15000 },
    { "kind": "click", "testid": "settings-nav-llm" },
    { "kind": "waitFor", "testid": "add-backend-btn", "timeoutMs": 15000 },
    { "kind": "screenshot", "label": "01-llm-backends" },
    { "kind": "click", "testid": "add-backend-btn" },
    { "kind": "waitFor", "testid": "llm-backend-dialog", "timeoutMs": 15000 },
    { "kind": "fill", "testid": "llm-dialog-name", "text": "automation-dummy" },
    { "kind": "screenshot", "label": "02-llm-add-dialog" },
    { "kind": "click", "testid": "llm-dialog-cancel" },
    { "kind": "sleep", "ms": 400 },

    { "kind": "goto", "route": "automations" },
    { "kind": "waitFor", "testid": "automations-page", "timeoutMs": 15000 },
    { "kind": "screenshot", "label": "03-automations" },

    { "kind": "goto", "route": "notifications" },
    { "kind": "sleep", "ms": 500 },
    { "kind": "click", "testid": "create-channel-btn" },
    { "kind": "waitFor", "testid": "create-channel-dialog", "timeoutMs": 15000 },
    { "kind": "fill", "testid": "channel-label-input", "text": "Automation demo" },
    { "kind": "fill", "testid": "channel-id-input", "text": "automation-demo" },
    { "kind": "fill", "testid": "channel-url-input", "text": "https://example.com/webhook" },
    { "kind": "screenshot", "label": "04-channel-dialog" },
    { "kind": "click", "testid": "create-channel-cancel-btn" },
    { "kind": "sleep", "ms": 400 },
    { "kind": "screenshot", "label": "05-notifications" }
  ]
}
