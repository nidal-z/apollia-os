{
  "name": "coach",
  "stopOnError": false,
  "steps": [
    {
      "kind": "waitFor",
      "testid": "app-main",
      "timeoutMs": 30000
    },
    {
      "kind": "goto",
      "route": "dashboard"
    },
    {
      "kind": "waitFor",
      "testid": "app-main"
    },
    {
      "kind": "click",
      "testid": "companion-sidebar-toggle"
    },
    {
      "kind": "waitFor",
      "testid": "companion-panel",
      "timeoutMs": 15000
    },
    {
      "kind": "waitFor",
      "testid": "companion-session-status",
      "timeoutMs": 8000
    },
    {
      "kind": "screenshot",
      "label": "01-coach-panel-open"
    },
    {
      "kind": "expect",
      "testid": "companion-drag-handle"
    },
    {
      "kind": "expect",
      "testid": "companion-resize-handle"
    },
    {
      "kind": "screenshot",
      "label": "02-coach-handles"
    },
    {
      "kind": "click",
      "testid": "companion-minimize"
    },
    {
      "kind": "sleep",
      "ms": 500
    },
    {
      "kind": "screenshot",
      "label": "03-coach-minimized"
    },
    {
      "kind": "click",
      "testid": "companion-sidebar-toggle"
    },
    {
      "kind": "waitFor",
      "testid": "companion-panel",
      "timeoutMs": 15000
    },
    {
      "kind": "screenshot",
      "label": "04-coach-restored"
    },
    {
      "kind": "click",
      "testid": "companion-close"
    },
    {
      "kind": "sleep",
      "ms": 500
    },
    {
      "kind": "screenshot",
      "label": "05-coach-closed"
    }
  ]
}
