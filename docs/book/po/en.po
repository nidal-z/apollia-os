msgid "/// Délai max avant annulation — défaut : 24 heures.\n"
msgstr "/// Délai max avant annulation — défaut : 24 heures.\n"

#: src/components/oria-engine.md:494
msgid "/// Intervalle de scan — défaut : 60 secondes.\n"
msgstr "/// Intervalle de scan — défaut : 60 secondes.\n"

#: src/components/oria-engine.md:499
msgid "**Pipeline d'annulation :**"
msgstr "**Pipeline d'annulation :**"

#: src/components/oria-engine.md:500
msgid ""
"```\n"
"TimeoutWatcher.scan_and_cancel() :\n"
"  ├── TaskRepository.find_input_required_older_than(input_required_timeout)\n"
"  ├── Pour chaque tâche expirée :\n"
"  │   ├── TaskRouter.cancel_task(task_id, \"input_required_timeout\")\n"
"  │   │     └── TaskStatus → Canceled\n"
"  │   └── EventBus.broadcast(RuntimeEvent::TaskApprovalTimeout { task_id, "
"after_secs })\n"
"  └── Retourne le nombre de tâches annulées\n"
"```"
msgstr ""
"```\n"
"TimeoutWatcher.scan_and_cancel() :\n"
"  ├── TaskRepository.find_input_required_older_than(input_required_timeout)\n"
"  ├── Pour chaque tâche expirée :\n"
"  │   ├── TaskRouter.cancel_task(task_id, \"input_required_timeout\")\n"
"  │   │     └── TaskStatus → Canceled\n"
"  │   └── EventBus.broadcast(RuntimeEvent::TaskApprovalTimeout { task_id, "
"after_secs })\n"
"  └── Retourne le nombre de tâches annulées\n"
"```"

