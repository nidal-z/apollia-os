#: src/components/mcp.md:190
msgid "Handshake (STORY-330)"
msgstr "Handshake (STORY-330)"

#: src/components/mcp.md:192
msgid ""
"```\n"
"Runtime → Serveur :  {\"jsonrpc\":\"2.0\",\"id\":\"1\",\"method\":"
"\"initialize\",\"params\":{\"protocolVersion\":\"2024-11-05\","
"\"capabilities\":{},\"clientInfo\":{\"name\":\"apollia-mcp\",\"version\":"
"\"0.1.0\"}}}\n"
"Runtime ← Serveur :  {\"jsonrpc\":\"2.0\",\"id\":\"1\",\"result\":"
"{\"protocolVersion\":\"2024-11-05\",\"capabilities\":{},\"serverInfo\":"
"{\"name\":\"notion-mcp-server\",\"version\":\"1.0.0\"}}}\n"
"Runtime → Serveur :  {\"jsonrpc\":\"2.0\",\"method\":\"notifications/"
"initialized\",\"params\":{}}\n"
"```"
msgstr ""
"```\n"
"Runtime → Serveur :  {\"jsonrpc\":\"2.0\",\"id\":\"1\",\"method\":"
"\"initialize\",\"params\":{\"protocolVersion\":\"2024-11-05\","
"\"capabilities\":{},\"clientInfo\":{\"name\":\"apollia-mcp\",\"version\":"
"\"0.1.0\"}}}\n"
"Runtime ← Serveur :  {\"jsonrpc\":\"2.0\",\"id\":\"1\",\"result\":"
"{\"protocolVersion\":\"2024-11-05\",\"capabilities\":{},\"serverInfo\":"
"{\"name\":\"notion-mcp-server\",\"version\":\"1.0.0\"}}}\n"
"Runtime → Serveur :  {\"jsonrpc\":\"2.0\",\"method\":\"notifications/"
"initialized\",\"params\":{}}\n"
"```"

#: src/components/mcp.md:198
msgid "Découverte des outils (STORY-331)"
msgstr "Découverte des outils (STORY-331)"

#: src/components/mcp.md:200
msgid ""
"```\n"
"Runtime → Serveur :  {\"jsonrpc\":\"2.0\",\"id\":\"2\",\"method\":\"tools/"
"list\",\"params\":{}}\n"
"Runtime ← Serveur :  {\"jsonrpc\":\"2.0\",\"id\":\"2\",\"result\":{\"tools\":"
"[{\"name\":\"search\",\"description\":\"...\",\"inputSchema\":{...}}]}}\n"
"```"
msgstr ""
"```\n"
"Runtime → Serveur :  {\"jsonrpc\":\"2.0\",\"id\":\"2\",\"method\":\"tools/"
"list\",\"params\":{}}\n"
"Runtime ← Serveur :  {\"jsonrpc\":\"2.0\",\"id\":\"2\",\"result\":{\"tools\":"
"[{\"name\":\"search\",\"description\":\"...\",\"inputSchema\":{...}}]}}\n"
"```"

#: src/components/mcp.md:205
msgid "Exécution d'un outil (STORY-332)"
msgstr "Exécution d'un outil (STORY-332)"

#: src/components/mcp.md:207
