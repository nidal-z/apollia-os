@startuml seq-oria-orchestrated
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "JetBrains Mono"
skinparam defaultFontSize 11
skinparam ArrowColor #444444
skinparam BorderColor #444444
skinparam SequenceGroupBorderColor #888888

title Séquence - ORIA Mode Orchestré (ActorLoop) - Apollia OS

participant "ExecutionCoord." as coord #1a1a2e/e0e0ff
participant "Observer" as obs #1a1a2e/e0e0ff
participant "Reasoner\n(LLM)" as reasoner #4a3728/f5e6d3
participant "ActorLoop" as actor #1a1a2e/e0e0ff
participant "PlanRepository\n(SQLite)" as db #2a3a4a/cce5ff
participant "StepBudget" as budget #2a3a4a/cce5ff
participant "ResilienceLayer" as resilience #1a1a2e/e0e0ff
participant "ToolProxy\n(Rust tools)" as tools #1a1a2e/e0e0ff
participant "LlmRouter" as llm #4a3728/f5e6d3
participant "Agent Python" as agent #2d4a22/d4edda
participant "PlanCache\n(SQLite)" as cache #2a3a4a/cce5ff
participant "MemoryManager" as memory #2a3a4a/cce5ff
participant "EventBus" as bus #2a3a4a/cce5ff

== Phase 1 : Observer + Classification (scoring pondéré Sprint 20) ==

coord -> obs : observe(task, memory?)
obs -> obs : classify() → Orchestrated\n(scoring pondéré 7 facteurs\nseuil 0.40)
obs --> coord : ContextBundle { task, memory_snapshot }

== Phase 1b : Plan Cache Lookup (Sprint 20, ADR-036) ==

coord -> cache : compute_cache_key(agent, version, tools, input)\nlookup(key)

alt cache HIT (plan non expiré, TTL 7j)
  cache --> coord : ExecutionPlan (caché)
  coord -> bus : PlanCacheHit { plan_id }
  note right : Pas d'appel LLM → économie coût
else cache MISS
end

== Phase 2 : Planification (Reasoner LLM) ==

coord -> reasoner : plan(context_bundle)
note right : system_prompt du manifest injecté\n+ outils disponibles + budget max\n+ model_hint supporté (Sprint 20)

loop max 3 tentatives (JSON invalide)
  reasoner -> llm : complete(prompt_planner)
  llm --> reasoner : JSON raw

  alt JSON valide + pas de cycle
    reasoner -> reasoner : topological_sort(steps)\n→ ordre d'exécution
    reasoner --> coord : ExecutionPlan
  else JSON invalide / cycle détecté
    reasoner -> reasoner : message de correction\n→ retry
  end
end

coord -> bus : PlanGenerated { plan_id, step_count }

== Phase 3 : Persistance initiale ==

coord -> db : insert_plan(plan_id, task_id, agent_name, steps)
db --> coord : Ok

== Phase 4 : Exécution topologique (ActorLoop) ==

loop chaque step dans l'ordre topologique
  coord -> budget : is_exhausted() ?

  alt budget épuisé
    budget --> coord : true
    coord -> db : fail_plan(plan_id, "STEP_BUDGET_EXCEEDED")
    coord -> bus : PlanFailed
    coord --> coord : AIPResult::failed
  end

  coord -> db : start_step(plan_id, step_id)
  coord -> bus : StepStarted { step_id, num, total, desc }

  note right : StepContext injecte previous_outputs\n+ step_index + remaining_budget\ndans le prompt LLM (Sprint 20)

  alt step.model_hint présent (Sprint 20)
    coord -> llm : get(Some(model_hint))\nfallback default si introuvable
  end

  alt step.tool_hint présent
    coord -> resilience : pre_check(tool_name)

    alt circuit OPEN
      resilience --> coord : CircuitOpen
      coord -> db : fail_step(step_id, "CircuitOpen")
      coord -> bus : StepFailed { retryable: false }
    else circuit CLOSED / HALF_OPEN
      coord -> tools : ToolProxyTrait::invoke(tool_name, input)
      tools --> coord : output (String)
    end

  else step sans outil → appel LLM direct
    coord -> llm : complete(step.description + contexte steps précédents)
    llm --> coord : output (String)
  end

  alt step réussi
    coord -> resilience : record_success(tool_name)
    coord -> budget : increment_steps()
    coord -> db : complete_step(step_id, output)
    coord -> bus : StepCompleted { duration_ms }
    coord -> memory : record episodic\n(fire-and-forget, importance=0.6\ntroncature 200 chars - Sprint 20)

  else step échoué
    coord -> resilience : record_failure(tool_name)
    coord -> db : fail_step(step_id, error)
    coord -> bus : StepFailed { error, retryable }

    alt retryable ET replan_count < 2
      coord -> bus : PlanReplanning { attempt, failed_step }

      coord -> reasoner : replan(plan, failed_step, error,\nstep_results_so_far)
      reasoner -> llm : complete(prompt_replanner)
      llm --> reasoner : JSON révisé
      reasoner --> coord : ExecutionPlan (nouveau)

      note right : Les steps déjà complétés\nsont conservés dans completed_outputs
    else replan_count >= 2
      coord -> db : fail_plan(plan_id, "MAX_REPLAN_EXCEEDED")
      coord -> bus : PlanFailed
      coord --> coord : AIPResult::failed
    end
  end
end

== Phase 5 : Finalisation ==

coord -> db : complete_plan(plan_id)
coord -> cache : store(key, plan)\n(si cache MISS initial - Sprint 20)
coord -> bus : PlanCompleted { step_count, duration_ms }

alt hasattr(agent, "on_plan_complete")
  coord -> agent : on_plan_complete(step_results: dict[str,str], ctx)
  note right : step_results = { "s1": "output1", "s2": "output2" }
  agent --> coord : AIPResult (str post-traitement métier)
else hook absent
  coord -> coord : concaténation automatique\ndes outputs de tous les steps
end

coord --> coord : AIPResult::completed(final_output)
coord -> bus : TaskCompleted

@enduml
