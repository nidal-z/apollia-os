@startuml seq-a2a-full-chain
!theme plain
skinparam backgroundColor #FAFAFA
skinparam sequenceArrowThickness 1.5
skinparam roundcorner 6
skinparam defaultFontSize 12
skinparam defaultFontName "Helvetica"
skinparam ArrowColor #444444
skinparam BorderColor #444444
title Séquence A2A — Chaîne complète A -> B -> C avec garde-fous — Apollia OS

participant "Director (A)" as director #2d4a22
participant "Runtime" as runtime #1a1a2e
participant "A2AInvoker" as invoker #1a1a2e
participant "Worker1 (B)" as worker1 #2d4a22
participant "Worker2 (C)" as worker2 #2d4a22
participant "TaskRepository" as repo #2a3a4a

== Étape 1 — Director délègue à Worker1 ==

director -> runtime : ctx.delegate("worker1-skill", payload)
runtime -> invoker : invoke(\n  skill_id="worker1-skill",\n  parent_chain=[],\n  current_agent="director"\n)

== Validation chaîne — Délégation director → worker1 ==

invoker -> invoker : validate_chain(\n  parent_chain=[],\n  current="director",\n  target="worker1",\n  max_hops=5\n)

note right of invoker #d4f0d4
  len([]) = 0 < 5 : OK
  "worker1" not in [] : OK
  child_chain = ["director"]
end note

invoker -> repo : submit_with_chain(\n  agent="worker1",\n  delegation_chain=["director"]\n)
repo --> invoker : task_id

== Étape 3 — Worker1 délègue à Worker2 ==

invoker -> worker1 : dispatch task\n(delegation_chain=["director"])
note over worker1 #d4f0d4
  AIPTask {
    delegation_chain: ["director"]
  }
end note

worker1 -> runtime : ctx.delegate("worker2-skill", payload)
runtime -> invoker : invoke(\n  skill_id="worker2-skill",\n  parent_chain=["director"],\n  current_agent="worker1"\n)

invoker -> invoker : validate_chain(\n  parent_chain=["director"],\n  current="worker1",\n  target="worker2",\n  max_hops=5\n)

note right of invoker #d4f0d4
  len(["director"]) = 1 < 5 : OK
  "worker2" not in ["director"] : OK
  child_chain = ["director", "worker1"]
end note

invoker -> repo : submit_with_chain(\n  agent="worker2",\n  delegation_chain=["director", "worker1"]\n)

== Étape 4 — Worker2 exécute et retourne ==

invoker -> worker2 : dispatch task\n(delegation_chain=["director","worker1"])
note over worker2 #d4f0d4
  AIPTask {
    delegation_chain: ["director", "worker1"]
  }
end note

worker2 -> worker2 : ReAct loop\n(outillé)
worker2 --> invoker : AIPResult.completed(output_c)

invoker --> worker1 : Ok(output_c)

== Étape 5 — Worker1 agrège et retourne à Director ==

worker1 -> worker1 : agrège résultat
worker1 --> invoker : AIPResult.completed(output_b_aggregated)

invoker --> director : Ok(output_b_aggregated)

== Cas d'erreur — Worker1 tente de rappeler Director ==

note over worker1 #ffe0e0
  Cas d'erreur : Worker1 tente ctx.delegate("director-skill")
  director est déjà dans delegation_chain=["director"]
end note

worker1 -> runtime : ctx.delegate("director-skill", payload)
runtime -> invoker : invoke(\n  skill_id="director-skill",\n  parent_chain=["director"],\n  current_agent="worker1"\n)

invoker -> invoker : validate_chain(\n  parent_chain=["director"],\n  current="worker1",\n  target="director",\n  max_hops=5\n)

note right of invoker #FFCCCC
  "director" in ["director"] : CYCLE !
  return Err(CycleDetected { agent_id: "director" })
  Protège contre A -> B -> A
end note

invoker --> worker1 : Err(A2aError::CycleDetected)

@enduml
