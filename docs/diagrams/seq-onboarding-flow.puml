@startuml seq-onboarding-flow
!theme plain
skinparam backgroundColor #FEFEFE
skinparam sequenceArrowThickness 1.5
skinparam sequenceParticipantBorderColor #333333

title Flux d'onboarding v2.1 (ADR-086) — Apollia OS

actor User
participant "Supervisor" as Sup
participant "EventBus" as Bus
participant "Frontend\n(Desktop/CLI)" as UI
participant "ChatSessionManager" as Chat
participant "onboarding-agent\n(v2.1)" as Agent
participant "UserMemoryRepository" as Mem
participant "ToolRegistry\n(permission_rule_add\nHITL-gated)" as Tools

== Premier lancement ==

Sup -> Mem : is_empty()?
Mem --> Sup : true
Sup -> Bus : OnboardingRequired
Bus -> UI : SSE event

alt Configurer
  User -> UI : click "Configurer"
  UI -> Chat : create_session(mode=Agent,\nagent="onboarding-agent")
  Chat --> UI : SessionInfo { session_id }

  loop ≤ 4 turns — collecte 4 clés Tier 1
    User -> UI : message
    UI -> Chat : send_message(session_id, content)
    Chat -> Agent : converse(ctx, user_message, history)
    Agent -> Agent : LLM complete\n+ extract [REMEMBER]/[INFER]/[PROFILE]/[SUGGEST] tags
    Agent -> Mem : remember(key, value,\nsource="onboarding",\nconfidence=0.9|0.6)
    note right of Mem
      Clés Tier 1 collectées :
      · user.name          (confidence 0.9)
      · user.role          (confidence 0.9)
      · user.agents.hitl   (always|critical-only|never)
      · user.constraints.sovereignty
    end note
    Mem --> Agent : ok
    Agent --> Chat : (response_text, updated_history)
    Chat --> UI : response
    UI --> User : affichage (tags retirés)
  end

  == Phase 2 — Écriture clés meta + règles de permissions (ADR-086) ==

  Agent -> Mem : remember("onboarding.profile_type", "operator|builder")
  Agent -> Mem : remember("onboarding.version", "2.1")
  Agent -> Mem : remember("onboarding.suggested_agents", "[...]")

  Agent -> Tools : permission_rule_list()\n(idempotence — vérifier si règles existent déjà)
  Tools --> Agent : Vec<PrefixRule>

  loop pour chaque règle dérivée du profil (sovereignty + hitl)
    Agent -> Tools : permission_rule_add(tool_name, prefix, scope="global")
    note right of Tools
      Appel HITL-gated :
      le dialog desktop demande confirmation.
      L'utilisateur valide ou refuse chaque règle.
      (ADR-086 — agent never bypasses HITL)
    end note
    Tools --> Agent : Ok(rule_id) | UserDenied
  end

  Agent -> Mem : remember("onboarding.completed_at", "<ISO-8601>")\n(signal desktop — gate completion)
  Mem --> Agent : ok

  UI -> UI : clé onboarding.completed_at détectée\n→ animation confetti · gate débloquée

else Plus tard
  User -> UI : click "Plus tard"
  UI -> Mem : set_onboarding_skipped(true)
  UI -> UI : affiche badge rappel
  note right
    L'utilisateur peut relancer :
    - CLI : apollia-os onboard
    - Desktop : Settings
  end note
end

@enduml
