@startuml seq-timeline-aggregation
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "JetBrains Mono"
skinparam defaultFontSize 12
skinparam ArrowColor #444444
skinparam BorderColor #444444
title Séquence — Timeline Aggregation — Apollia OS

actor "Client HTTP" as client #3a3a3a
participant "APIServer\n(axum)" as api #1a1a2e
participant "spawn_blocking" as blocking #1a1a2e
database "hitl.db" as hitl #2a3a4a
database "plans.db" as plans #2a3a4a
database "llm_calls.db" as llm #2a3a4a
database "audit.db" as audit #2a3a4a

client -> api : GET /api/v1/tasks/{id}/timeline
activate api

api -> blocking : spawn_blocking(task_id)
activate blocking

note over blocking : Lecture parallèle\n5 sources SQLite

blocking -> hitl : read_task_data(task_id)\n→ transitions_json, output, duration
activate hitl
hitl --> blocking : TaskData
deactivate hitl

blocking -> hitl : read_approvals(task_id)\n→ HitlSuspended + HitlResolved
activate hitl
hitl --> blocking : Vec<(timestamp, event)>
deactivate hitl

blocking -> plans : read_plan_steps(task_id)\n→ StepStarted + StepCompleted
activate plans
plans --> blocking : Vec<(timestamp, event)>
deactivate plans

blocking -> llm : read_llm_calls(task_id)\n→ LlmCall events
activate llm
llm --> blocking : Vec<(timestamp, event)>
deactivate llm

blocking -> audit : read_tool_calls(task_id)\n→ ToolCall events
activate audit
audit --> blocking : Vec<(timestamp, event)>
deactivate audit

note over blocking : Merge + sort ASC\npar timestamp

blocking -> blocking : parse_transitions()\n→ TaskTransition events
blocking -> blocking : append TaskCompleted\n(événement terminal)

blocking --> api : TimelineResponse
deactivate blocking

api --> client : 200 JSON\n{ task_id, events: [...] }
deactivate api

@enduml
