@startuml seq-pipeline-execution
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "JetBrains Mono"
skinparam defaultFontSize 11
skinparam ArrowColor #444444
skinparam BorderColor #444444
skinparam SequenceGroupBorderColor #888888

title Séquence — Exécution d'un Pipeline (fan-out topologique) — Apollia OS

actor "User / CLI\nou Trigger" as user #3a3a3a/white
participant "PipelineEngine\n(acteur Tokio)" as engine #1a1a2e/e0e0ff
participant "PipelineExecutor\n(tâche détachée)" as exec #1a1a2e/e0e0ff
participant "topological_layers()" as topo #1a1a2e/e0e0ff
participant "TemplateRenderer" as tmpl #1a1a2e/e0e0ff
participant "TaskRouter" as router #1a1a2e/e0e0ff
participant "Agent(s) Python" as agents #2d4a22/d4edda
participant "PipelineRepository\n(SQLite)" as db #2a3a4a/cce5ff
participant "EventBus" as bus #2a3a4a/cce5ff

== Phase 1 — Démarrage du run ==

user -> engine : run_pipeline("traitement-facture",\n  trigger_payload="facture.pdf")
engine -> engine : lookup PipelineDefinition\n→ 4 steps définis

engine -> db : insert_run(run_id="r-3f7a2b9c", status=Running)
db --> engine : Ok

engine -> exec : tokio::spawn(PipelineExecutor::new(\n  definition, run, submitter, event_bus, repo\n))
engine --> user : Ok(RunId("r-3f7a2b9c"))
note right of engine
  run_id retourné immédiatement.
  L'exécution se fait en arrière-plan
  dans une tâche Tokio détachée.
end note

== Phase 2 — Calcul des layers topologiques ==

exec -> topo : topological_layers(steps: [ocr, validation,\n  extraction, comptabilisation])
note right of topo
  Algorithme de Kahn (BFS) :
  dépendances → layers parallèles.

  ocr          (aucune dép.)  → Layer 0
  validation   (dép: ocr)     → Layer 1
  extraction   (dép: ocr)     → Layer 1
  comptabilisation (dép: val,\n  ext)    → Layer 2
end note
topo --> exec : [[ocr], [validation, extraction], [comptabilisation]]

bus <-- exec : PipelineStarted { pipeline_id, run_id }

== Phase 3 — Layer 0 : step séquentiel ==

group Layer 0 — 1 step
  exec -> exec : evaluate_condition(step=ocr)\n→ pas de condition → exécute
  exec -> tmpl : render("{{trigger.payload}}")\n→ "facture.pdf"
  exec -> router : submit_task("ocr-agent", "facture.pdf")
  router --> exec : task_id="t-0021"
  exec -> db : update_step(run_id, step_id="ocr", task_id, Running)
  bus <-- exec : PipelineStepStarted { run_id, step_id="ocr", task_id }

  agents --> bus : TaskCompleted { task_id, output: "Facture ACME 12500€" }
  exec <-- bus : (subscribe filtre sur task_id)
  exec -> db : update_step(ocr, Completed, output="Facture ACME 12500€")
  bus <-- exec : PipelineStepCompleted { run_id, step_id="ocr" }
end

== Phase 4 — Layer 1 : fan-out parallèle ==

group Layer 1 — 2 steps en parallèle (FuturesUnordered)
  note over exec
    FuturesUnordered regroupe les deux
    futures de soumission. Les deux tasks
    sont soumises quasi-simultanément.
  end note

  exec -> tmpl : render("{{steps.ocr.output}}")\n→ "Facture ACME 12500€"  [×2]

  exec -> router : submit_task("validation-agent", "Facture ACME 12500€")
  router --> exec : task_id="t-0022"

  exec -> router : submit_task("extraction-agent", "Facture ACME 12500€")
  router --> exec : task_id="t-0023"

  exec -> db : update_step(validation, Running, t-0022)
  exec -> db : update_step(extraction, Running, t-0023)
  bus <-- exec : PipelineStepStarted { step_id="validation" }
  bus <-- exec : PipelineStepStarted { step_id="extraction" }

  agents --> bus : TaskCompleted { task_id="t-0022", output="VALIDE" }
  agents --> bus : TaskCompleted { task_id="t-0023", output="lignes: [...]" }

  exec <-- bus : (les 2 résultats arrivent — FuturesUnordered drainé)
  exec -> db : update_step(validation, Completed, "VALIDE")
  exec -> db : update_step(extraction, Completed, "lignes: [...]")
  bus <-- exec : PipelineStepCompleted { step_id="validation" }
  bus <-- exec : PipelineStepCompleted { step_id="extraction" }
end

== Phase 5 — Layer 2 : fan-in ==

group Layer 2 — 1 step (fan-in)
  exec -> tmpl : render("Valide: {{steps.validation.output}}\n  Lignes: {{steps.extraction.output}}")\n→ "Valide: VALIDE\nLignes: [...]"
  exec -> router : submit_task("compta-agent", "Valide: VALIDE\nLignes: [...]")
  router --> exec : task_id="t-0024"
  agents --> bus : TaskCompleted { task_id="t-0024", output="Enregistré #INV-2026-042" }
  exec <-- bus
  exec -> db : update_step(comptabilisation, Completed, "Enregistré #INV-2026-042")
  exec -> db : complete_run(run_id, Completed)
  bus <-- exec : PipelineCompleted { run_id }
end

@enduml
