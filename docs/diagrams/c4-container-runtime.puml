@startuml c4-container-runtime
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "JetBrains Mono"
skinparam defaultFontSize 12
skinparam ArrowColor #444444
skinparam BorderColor #444444

title C4 Container - Workspace (16 crates) - Apollia OS

actor "Opérateur" as ops #3a3a3a/white
actor "Développeur" as dev #3a3a3a/white
actor "Utilisateur Desktop" as desktop_user #3a3a3a/white

rectangle "Apollia OS Workspace" as workspace #1a1a2e {

  rectangle "apollia-desktop\n(Tauri v2 + Svelte 5)\nRegistryClient · SecretStore\nPage Intégrations · Wizard" as desktop #1a1a2e

  rectangle "apollia-cli\n(binaire clap v4)" as cli #1a1a2e

  rectangle "apollia-runtime\n(Runtime Core)" as runtime #1a1a2e {
    component "Supervisor" as sup
    component "AgentRegistry" as reg
    component "TaskRouter" as router
    component "ExecutionCoordinator" as coord
    component "APIServer (axum)" as api
    component "EventBus (broadcast)" as bus
  }

  rectangle "apollia-oria\n(ORIA Engine)" as oria #1a1a2e {
    component "Observer\nContextBundle" as obs
    component "Reasoner (LLM)\nExecutionPlan" as reasoner
    component "StepBudget\nResilienceLayer" as budget
  }

  rectangle "apollia-permissions\n(Moteur de Permissions)" as perms #1a1a2e {
    component "PermissionEngine::decide()\nSafeList · PrefixRuleEngine\nStructuralInjectionDetector\nPermissionAuditLog (SQLite)" as permengine
  }

  rectangle "apollia-tools\n(Tool Registry)" as tools #1a1a2e {
    component "ToolRegistry · ToolDispatcher\nAuditTrail · SandboxRoot\nBashValidator · RiskClassifier\nFilePathExtractor" as reg2
    component "BashExecutor · PythonExecutor\nfile_read/write/edit/list/glob/grep\nhttp_fetch · memory_search" as native
  }

  rectangle "apollia-mcp\n(Client + Serveur MCP)" as mcp_crate #1a1a2e {
    component "McpClientManager\n(acteur Tokio)" as mcpmanager
    component "McpSession · McpToolExecutor\nMcpConfigWriter" as mcpsession
    component "McpStdioServer\n(9 outils natifs + submit_task)" as mcpserver
    component "resolve_env()\n(APOLLIA_SECRET: prefix)" as secretresolver
  }

  rectangle "apollia-memory\n(Memory Engine)" as memory #2a3a4a {
    component "MemoryManager\nEpisodic / Semantic\nProcedural / FTS5" as mem
  }

  rectangle "apollia-aip\n(PyO3 Bridge)" as aip #1a1a2e {
    component "AIPBridge\nToolProxy\nMemoryInterface\nLlmProxy" as bridge
  }

  rectangle "apollia-llm\n(LLM Engine)" as llm #4a3728 {
    component "LlmRouter\nroute_precise() · route_fast()\nLlmRoutingLevel (Precise | Fast)\nTokenBudget · TokenBudgetUpdated" as llmrouter
    component "EmbeddedBackend [local]\nOpenAICompatibleClient [cloud]\nAnthropicClient [cloud]" as backends
  }

  rectangle "apollia-triggers\n(Triggers Engine)" as triggers #1a1a2e {
    component "TriggerEngine (acteur Tokio)\nTriggerEngineHandle\nTriggerPersistence (SQLite)" as trigengine
    component "CronTrigger · IntervalTrigger\nOneshotTrigger · FileWatchTrigger\nWebhook (axum route HMAC-SHA256)" as trigsources
  }

  rectangle "apollia-workspace\n(Workspace Isolation)" as workspace_crate #1a1a2e {
    component "WorkspaceManager\nAgentWorkspace\nContextProvider\nProjectScoping" as wsmanager
  }

  rectangle "apollia-auth\n(OAuth2 PKCE)" as auth #1a1a2e {
    component "OAuth2 PKCE flow\nToken Keyring\nAuto-refresh (ADR-016)" as authengine
  }

  rectangle "apollia-notifications\n(Notifications Engine)" as notifications #1a1a2e {
    component "NotificationEngine (acteur Tokio pos.9)\nNotificationChannel trait\nDesktop · Email · Webhook" as notifengine
  }

  rectangle "apollia-stt\n(STT Engine)" as stt #1a1a2e {
    component "SttBackend trait\nWhisperCppBackend\n(whisper-rs 0.16)" as sttbackend
    component "AudioCapture (cpal)\nResampler (rubato)\nSilenceDetector" as audio
    component "SttRepository\n(SQLite)" as sttrepo
  }

  rectangle "apollia-core\n(types partagés)" as core #1a1a2e {
    component "AgentManifest\nAIPTask / AIPResult\nProcessState / TaskStatus\nRuntimeEvent (TriggerFired…\nTaskCompleted…)\ndelegation_chain: Vec<AgentId>" as types
  }
}

rectangle "Agent Python\n(LangGraph / CrewAI / Custom)" as agent #2d4a22

database "SQLite\n(FTS5)" as sqlite #2a3a4a

rectangle "Linux namespaces\n(unshare, sandbox)" as sandbox #4a3728

rectangle "Serveur MCP\n(subprocess stdio local)" as mcp #4a3728

rectangle "API Cloud LLM\n(OpenAI / Anthropic\noptionnel [feature=cloud])" as cloudllm #4a3728

rectangle "MCP Registry API\n(registry.modelcontextprotocol.io)" as mcp_registry #4a3728

rectangle "OS Keychain\n(macOS Keychain / D-Bus / WinCred)" as keychain #4a3728

ops --> cli : apollia-os [cmd]
dev --> agent : écrit
desktop_user --> desktop : double-clic
desktop --> runtime : init_embedded()\nRuntimeHandle (in-process)
cli --> runtime : RuntimeClient (HTTP Unix socket)
runtime --> oria : dispatch tâche
oria --> tools : ctx.tools.call()
oria --> memory : ctx.memory.*
oria --> llm : Reasoner\nArc<dyn CompletionModel>
runtime --> aip : AIPBridge.call_run()
aip --> agent : PyO3 (asyncio.run)
aip --> llm : ctx.llm (LlmProxy)
agent --> aip : AIPResult (dict)
tools --> perms : PermissionEngine::decide()\n(avant chaque invocation)
perms --> tools : AutoAllowed* | AutoDenied* | NeedsApproval
tools --> sandbox : bash_executor\npython_executor
mcp_crate --> mcp : JSON-RPC 2.0 stdio\n(subprocess local)
runtime --> mcp_crate : McpClientManagerHandle\n(Phase 3b startup)
memory --> sqlite : INSERT / FTS5 MATCH
triggers --> runtime : TriggerEvent → TaskRouter\n(submit AIPTask)
triggers --> sqlite : trigger_history\ntrigger_state
notifications --> runtime : abonnement EventBus\n(TaskCompleted / TriggerFired...)
llm --> cloudllm : HTTP REST\n(feature = cloud)
desktop --> stt : SttFlow\n(hotkey → record → transcribe)
runtime --> stt : SttEngine actor\n(Phase 15)
stt --> sqlite : stt_transcriptions\nstt.db
desktop --> mcp_registry : RegistryClient\n(HTTP GET /v0.1/servers, cache local)
desktop --> keychain : SecretStore\n(keyring crate - store/load secrets)
mcp_crate --> keychain : resolve_env()\n(APOLLIA_SECRET: → keychain read)

@enduml
