@startuml c4-component-runtime-core
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "JetBrains Mono"
skinparam defaultFontSize 12
skinparam ArrowColor #444444
skinparam BorderColor #444444

title C4 Component — Runtime Core (Acteurs Tokio) — Apollia OS

rectangle "apollia-runtime" as runtime #1a1a2e {

  rectangle "Supervisor\n(démarrage ordonné + watchdog)" as sup #1a1a2e

  queue "EventBus\nbroadcast::Sender<RuntimeEvent>\ncapacité 1024" as bus #2a3a4a

  rectangle "AgentRegistry\nmpsc acteur Tokio\nHashMap<AgentId, AgentEntry>\nHashMap<String, AgentId>" as reg #1a1a2e

  rectangle "TaskRouter\nmpsc acteur Tokio\nHashMap<TaskId, TaskState>\nHashMap<AgentId, Coordinator>" as router #1a1a2e

  rectangle "ExecutionCoordinator\nSemaphore(max_concurrent)\nun par agent actif" as coord #1a1a2e

  rectangle "APIServer (axum 0.7)\nUnix socket /tmp/apollia.sock\nTCP 0.0.0.0:7771\nwatch::channel shutdown" as api #1a1a2e

  rectangle "ShutdownController\nSIGTERM / SIGINT\ndrain 30s" as shutdown #1a1a2e
}

rectangle "LlmRouter\nArc<dyn CompletionModel>\nposition 5 Supervisor" as llm #4a3728

rectangle "TriggerEngine\nmpsc acteur Tokio\nTriggerDefinitions + sources\nposition 6 Supervisor" as trig #1a1a2e

rectangle "ORIA Engine" as oriabox #1a1a2e {
  rectangle "Observer + Reasoner\n(classify + LLM plan)" as oria #1a1a2e
  rectangle "ActorLoop\n(exécution topologique\nToolProxyTrait + replan max 2)" as actor #1a1a2e
  database "PlanRepository\n(~/.apollia/plans.db)\nmigration 004" as plandb #2a3a4a
}
rectangle "AIP Bridge (PyO3)\n(RuntimeContext + LlmProxy\n+ on_plan_complete hook)" as aip #1a1a2e
actor "CLI / Client HTTP / Browser" as cli #3a3a3a/white

' --- ordre de démarrage Supervisor (1→7) ---
sup --> bus    : 1. démarre\nen premier
sup --> reg    : 2. démarre
sup --> oria   : 3. démarre\n(ToolRegistry + MemoryEngine)
sup --> llm    : 5. LlmRouter::from_config_with_bus()\nLlmModelReady / Failed → bus
sup --> trig   : 6. TriggerEngine::start(defs)\nTriggersReloaded → bus
sup --> router : (TaskRouter démarré étape 3-4)
sup --> api    : 7. démarre\nen dernier

bus ..> reg    : broadcast\nRuntimeEvent
bus ..> router : broadcast\nRuntimeEvent
bus ..> api    : broadcast\n(SSE stream)\nLlmCallCompleted…

reg    --> bus    : publie\nAgentTransitioned
llm    --> bus    : publie\nLlmModelLoading / Ready / Failed\nLlmCallCompleted

router --> reg    : GetByName / Transition\n(mpsc message)
router --> coord  : dispatch\nSubmitTask

coord  --> oria   : execute_direct()\n(Mode Direct)
coord  --> actor  : execute_orchestrated()\n(Mode Orchestré)
actor  --> plandb : insert_plan / start_step\ncomplete_step / complete_plan
actor  --> bus    : PlanGenerated / StepStarted\nStepCompleted / StepFailed\nPlanReplanning / PlanCompleted
coord  --> bus    : publie\nTaskCompleted / TaskFailed

api    --> router : Submit / GetStatus / Cancel\n(mpsc message)
api    --> reg    : List / GetById\n(mpsc message)
api    --> llm    : GET /llm/status\nPOST /llm/ping\nPOST /llm/chat
api    --> trig   : GET /triggers\nPOST /triggers/:id/fire\nPOST /webhooks/:id\nGET /dashboard

trig   --> router : submit AIPTask\n(TriggerFired)
trig   --> bus    : publie TriggerFired\nTriggerSkipped / TriggerError\nTriggersReloaded

aip    --> llm    : ctx.llm (LlmProxy)\nArc<LlmRouter>

shutdown --> bus    : publie\nShutdownRequested
shutdown --> router : GetActiveTasks\n(drain)

cli --> api : HTTP REST\n/ SSE

@enduml
