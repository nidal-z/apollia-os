@startuml seq-oria-loop
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "JetBrains Mono"
skinparam defaultFontSize 11
skinparam ArrowColor #444444
skinparam BorderColor #444444
skinparam SequenceGroupBorderColor #888888

title Séquence — ORIA Engine (Mode Direct & Orchestré) — Apollia OS

participant "ExecutionCoord." as coord #1a1a2e/e0e0ff
participant "Observer" as obs #1a1a2e/e0e0ff
participant "Reasoner\n(LLM)" as reasoner #4a3728/f5e6d3
participant "StepBudget" as budget #2a3a4a/cce5ff
participant "ResilienceLayer" as resilience #1a1a2e/e0e0ff
participant "Agent Python" as agent #2d4a22/d4edda
participant "ToolRegistry" as tools #1a1a2e/e0e0ff

coord -> obs : observe(task, memory?)

obs -> obs : classify(ContextBundle)\n→ ExecutionMode

alt Mode Direct (tâche courte, outils simples)

  obs --> coord : Direct

  loop chaque étape (jusqu'à max_steps)
    coord -> budget : check_remaining()

    alt budget épuisé
      budget --> coord : BudgetExceeded
      coord --> coord : TaskStatus::Failed\n(code: BUDGET_EXCEEDED)
    end

    coord -> agent : agent.run(task, ctx)\n[ctx.llm disponible si LlmRouter présent]
    agent -> resilience : pre_check("bash_executor")

    alt circuit OPEN
      resilience --> agent : ResilienceError::CircuitOpen
    else circuit CLOSED / HALF_OPEN
      agent -> tools : execute("bash_executor", input)
      tools --> agent : result

      alt succès
        agent -> resilience : record_success("bash_executor")
      else échec transitoire
        agent -> resilience : record_failure("bash_executor")
        resilience -> resilience : backoff jitter\n(100ms × 2^n ±25%)
        note right : max 3 retries\nTransient only
      end
    end

    agent --> coord : AIPResult
    coord -> budget : decrement(steps=1, tool_calls=N)
  end

else Mode Orchestré (tâche complexe, multi-étapes)

  obs --> coord : Orchestrated

  coord -> reasoner : plan(context_bundle)\n[Arc<dyn CompletionModel>]

  loop retry JSON (max 3 si parse échoue)
    reasoner -> reasoner : complete(prompt_planner)
    reasoner -> reasoner : parse JSON → ExecutionPlan
    alt JSON invalide
      reasoner -> reasoner : correction_message\n→ retry
    end
  end

  reasoner --> coord : ExecutionPlan { steps: Vec<PlanStep> }

  loop chaque step du plan
    coord -> budget : check_remaining()

    alt budget épuisé
      budget --> coord : BudgetExceeded
      coord --> coord : TaskStatus::Failed
    end

    coord -> agent : agent.run(step_task, ctx)
    agent --> coord : StepResult

    alt step failed ET replan_count < 2
      coord -> reasoner : replan(plan, failed_step, error)
      reasoner --> coord : ExecutionPlan (révisé)
    else replan_count >= 2
      coord --> coord : TaskStatus::Failed\n(MAX_REPLAN_EXCEEDED)
    end
  end

end

@enduml
