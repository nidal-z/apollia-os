@startuml seq-memory-usage
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "JetBrains Mono"
skinparam defaultFontSize 11
skinparam ArrowColor #444444
skinparam BorderColor #444444

title Séquence - Memory Usage (record + search) - Apollia OS

participant "Agent Python" as agent #2d4a22/d4edda
participant "MemoryInterface\n(PyO3 #[pyclass])" as iface #1a1a2e/e0e0ff
participant "MemoryManager\n(Rust)" as mgr #1a1a2e/e0e0ff
participant "MemoryStore\n(SQLite)" as store #2a3a4a/cce5ff
participant "FTS5 Index\n(memory_fts)" as fts #2a3a4a/cce5ff

== ctx.memory.record() - Stocker un épisode ==

agent -> iface : await ctx.memory.record(\n  "Client Acme - 10 licences Figma",\n  importance=0.8,\n  task_id="t-abc123"\n)

iface -> iface : spawn_blocking\n(opération SQLite sync\ndans thread dédié)

iface -> mgr : record_inner(content, 0.8, task_id)
mgr -> mgr : check_write_access()\n(ReadWrite requis)
mgr -> store : store(namespace)
note right of store : lazy open -\nSQLite ouvert au\npremier accès

store -> store : INSERT INTO episodic_memories\n(id, namespace, content,\n importance, task_id, created_at)
store -> fts : INSERT INTO memory_fts\n(id, namespace, content, type)

store --> mgr : memory_id (UUID)
mgr --> iface : Ok(memory_id)
iface --> agent : "mem-uuid-xyz"

== ctx.memory.search() - Recherche full-text ==

agent -> iface : await ctx.memory.search(\n  "licences Figma",\n  limit=5\n)

iface -> iface : spawn_blocking

iface -> mgr : search_inner("licences Figma", 5)
mgr -> store : store(namespace)

store -> fts : SELECT e.*, fts.rank\nFROM memory_fts fts\nJOIN episodic_memories e\n  ON e.id = fts.id\nWHERE memory_fts MATCH 'licences Figma'\n  AND fts.namespace = ?\nORDER BY fts.rank\nLIMIT 5

note over fts
  FTS5 tokenizer : unicode61
  Ranking : BM25 natif SQLite
  Cross-backend : épisodique + sémantique + procédural
end note

fts --> store : rows[{content, score, type, created_at}]
store --> mgr : Vec<MemorySearchResult>
mgr --> iface : Ok(results)
iface --> agent : [\n  {"content": "...", "score": 0.92, "type": "episodic"},\n  {"content": "...", "score": 0.71, "type": "semantic"}\n]

== ctx.memory.recall_entry() - Métadonnées complètes ==

agent -> iface : await ctx.memory.recall_entry(\n  "client.dupont_sa.budget_max"\n)

iface -> iface : spawn_blocking

iface -> mgr : recall_entry_inner(key)
mgr -> store : store(namespace)

store -> store : SELECT id, namespace, key, value,\n  source, confidence, created_at,\n  updated_at, expires_at\nFROM semantic_memories\nWHERE namespace = ? AND key = ?\n  AND (expires_at IS NULL\n       OR expires_at > datetime('now'))

store --> mgr : Option<SemanticEntry>
mgr --> iface : Ok(entry_or_none)
iface --> agent : {"key": "...", "value": "15000",\n  "confidence": 1.0, "source": "agent:crm",\n  "updated_at": "2026-03-05T14:30:00Z",\n  "expires_at": null}

== ctx.memory.recall_all() - Lister le namespace ==

agent -> iface : await ctx.memory.recall_all(\n  limit=50\n)

iface -> iface : spawn_blocking

iface -> mgr : recall_all_inner(limit=50)
mgr -> store : store(namespace)

store -> store : SELECT * FROM semantic_memories\nWHERE namespace = ?\n  AND (expires_at IS NULL\n       OR expires_at > datetime('now'))\nORDER BY key ASC\nLIMIT 50

store --> mgr : Vec<SemanticEntry>
mgr --> iface : Ok(entries)
iface --> agent : [\n  {"key": "k1", "value": "...", "confidence": 0.9, ...},\n  {"key": "k2", "value": "...", "confidence": 1.0, ...}\n]

@enduml
