@startuml seq-config-to-actors
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "JetBrains Mono"
skinparam defaultFontSize 11
skinparam ArrowColor #444444
skinparam BorderColor #444444
skinparam SequenceGroupBorderColor #888888

title Séquence — apollia.toml → Supervisor::start() → Acteurs — Apollia OS

participant "apollia.toml\n(fichier)" as toml #4a3728/f5e6d3
participant "parse_apollia_toml()\n(apollia-cli)" as cfg #1a1a2e/e0e0ff
participant "Supervisor::start()\n(apollia-runtime)" as sup #1a1a2e/e0e0ff

participant "EventBus\n(broadcast)" as bus #2a3a4a/cce5ff
participant "AgentRegistry\n(pos 2)" as reg #1a1a2e/e0e0ff
participant "ToolRegistry\n+ native tools (pos 3)" as tools #1a1a2e/e0e0ff
participant "LlmRouter\n(pos 4)" as llm #4a3728/f5e6d3
participant "TaskRouter\n(pos 5)" as router #1a1a2e/e0e0ff
participant "TriggerEngine\n(pos 6)" as trig #1a1a2e/e0e0ff
participant "PipelineEngine\n(pos 7)" as pipe #1a1a2e/e0e0ff
participant "APIServer\n(pos 8)" as api #1a1a2e/e0e0ff
participant "NotificationEngine\n(pos 9)" as notif #1a1a2e/e0e0ff

== Parsing (apollia-cli) ==

toml -> cfg : std::fs::read_to_string(path)
cfg -> cfg : toml::from_str::<RawApolliaCConfig>(content)
note right : ApolliaCConfig { llm, triggers, pipelines }\n[agents] section optionnelle\n[[triggers]] validés par parse_triggers()\n[[pipelines]] validés par validate_pipeline()

cfg --> sup : ApolliaCConfig →\nSupervisorConfig {\n  llm_config: Option<LlmConfig>,\n  triggers: Vec<TriggerDefinition>,\n  pipelines: Vec<PipelineDefinition>,\n  notifications: Option<NotificationConfig>,\n  data_dir, startup_timeout_secs, ...\n}

== Supervisor::start() — Démarrage séquentiel ==

sup -> bus : EventBus::new()\n→ (EventBusSender, broadcast::Receiver)
note right : Position 1 — toujours démarré en premier\nSender cloné vers tous les acteurs

sup -> reg : AgentRegistry::spawn(event_sender)
note right : Position 2 — dépend uniquement de l'EventBus

sup -> tools : ToolRegistryHandle::start()\npuis register(BashExecutor)\nregister(PythonExecutor)\nregister(FileIo)
note right : Position 3 — 3 outils natifs enregistrés\nautomatiquement

alt [llm] présent dans apollia.toml
  sup -> llm : LlmRouter::from_config_with_bus(\n  llm_config, Some(event_sender)\n)
  note right : Position 4 — section [llm]\nChaque [[llm.backends]] → AnthropicClient\nou OpenAICompatibleClient ou EmbeddedBackend\nÉchec non fatal : runtime continue sans LLM
  llm --> sup : Arc<LlmRouter>
else [llm] absent
  sup -> sup : llm_router = None\n(AgentContext.llm == None)
end

sup -> router : TaskRouterHandle::spawn(\n  registry_handle,\n  event_sender,\n  capacity=256\n)
note right : Position 5 — dépend de AgentRegistry\nreçoit event_bus pour observer ShutdownRequested

sup -> trig : TriggerEngineHandle::spawn(\n  triggers: Vec<TriggerDefinition>,\n  router_handle,\n  event_sender,\n  ...\n)
note right : Position 6 — section [[triggers]]\nDémarré avec les triggers validés\n(vide = 0 actif, pas d'erreur)

alt [[pipelines]] non vide
  sup -> pipe : PipelineEngine::spawn(\n  pipelines,\n  repo (SQLite pipelines.db),\n  submitter (router_handle),\n  event_sender\n)
  note right : Position 7 — section [[pipelines]]\nOuvre data_dir/pipelines.db\nExécute migrations SQL\nReprend les runs interrompus au démarrage\n(find_running_runs)
  pipe --> sup : PipelineEngineHandle
else [[pipelines]] vide ou absent
  sup -> sup : pipeline_engine = None
end

sup -> api : APIServer::bind(\n  api_config (socket_path + tcp_port),\n  AppState { registry, router, tools,\n    llm_router, trigger_engine,\n    pipeline_engine, ... }\n)
note right : Position 8 — écoute sur :\n- Unix socket (/tmp/apollia.sock)\n- TCP localhost:7771\nRoutes : /api/v1/{agents,tasks,pipelines,\ntriggers,llm,dashboard,runs,health,shutdown}

alt [notifications] présent dans apollia.toml
  sup -> notif : build_channels(notification_config)\n→ NotificationEngine::spawn(\n  channels, event_bus\n)
  note right : Position 9 — section [notifications]\nCanaux : desktop (notify-rust),\ne-mail, webhook (HTTP)\nCrash non fatal — runtime continue
else [notifications] absent
  sup -> sup : notification_engine = None
end

sup -> sup : emit RuntimeEvent::AllReady
sup --> sup : SupervisorHandles {\n  event_sender,\n  registry_handle,\n  tool_registry_handle,\n  router_handle,\n  api_handle,\n  llm_router,\n  trigger_engine,\n  pipeline_engine,\n}

note over sup : Rollback partiel si APIServer échoue :\nTriggerEngine, TaskRouter, ToolRegistry,\nAgentRegistry arrêtés en ordre inverse

@enduml
