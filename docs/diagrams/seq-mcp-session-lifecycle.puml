@startuml seq-mcp-session-lifecycle
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "JetBrains Mono"
skinparam defaultFontSize 12
skinparam ArrowColor #444444
skinparam BorderColor #444444
title Séquence - Cycle de vie session MCP - Apollia OS

participant "Agent Python" as agent #2d4a22
participant "McpToolExecutor" as executor #1a1a2e
participant "McpClientManager" as manager #1a1a2e
participant "McpSession" as session #1a1a2e
participant "MCP Server\n(subprocess)" as server #4a3728
participant "ToolRegistry" as registry #1a1a2e

== Configuration (boot) ==

manager -> manager : load mcp.toml\n(secrets via env vars)

note over manager
  **Lazy start** : sessions créées
  au premier appel d'outil.
end note

== Première invocation - Lazy Start ==

agent -> executor : ctx.tools.call("mcp:notion/search", args)
executor -> manager : get_or_create_session("notion")
manager -> server : spawn(["npx", "server-notion"])\nstdin + stdout pipes
activate server

== Handshake ==

session -> server : {"method":"initialize",...}
server --> session : {"result": {"capabilities":...}}
session -> server : {"method":"notifications/initialized"}

== Discovery ==

session -> server : {"method":"tools/list"}
server --> session : {"result": {"tools": [...]}}
session -> registry : register mcp:notion/search,\nmcp:notion/query, ...

== Tool Call ==

executor -> session : call_tool("search", args)
session -> server : {"method":"tools/call","params":{...}}
server --> session : {"result": {"content": [...]}}
session --> executor : McpToolResult
executor --> agent : result

== HITL (si requires_approval) ==

note over executor #FFCCCC
  requires_approval: true →
  vérifier authorized_tools
  avant exécution.
  Non approuvé → TaskInputRequired
end note

== Graceful Shutdown ==

manager -> session : shutdown()
session -> server : close stdin
session -> session : wait 5s
session -> server : kill (si actif)
deactivate server

@enduml
