@startuml seq-supervisor-startup
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "JetBrains Mono"
skinparam defaultFontSize 11
skinparam ArrowColor #444444
skinparam BorderColor #444444
skinparam SequenceGroupBorderColor #888888

title Séquence — Démarrage ordonné Supervisor (9 phases) — Apollia OS

participant "CLI\n(apollia-os start)" as cli #3a3a3a/ffffff
participant "Supervisor" as sup #1a1a2e/e0e0ff
participant "EventBus" as bus #2a3a4a/cce5ff
participant "AgentRegistry" as reg #1a1a2e/e0e0ff
participant "ToolRegistry" as tools #1a1a2e/e0e0ff
participant "LlmRouter" as llm #4a3728/f5e6d3
participant "TaskRouter" as router #1a1a2e/e0e0ff
participant "APIServer" as api #1a1a2e/e0e0ff
participant "TriggerEngine" as trig #2d4a22/d4edda
participant "NotificationEngine" as notif #4a3728/f5e6d3

cli -> sup : Supervisor::start(config, agent_loader)

' Phase 1
sup -> bus : EventBus::new()\n→ (event_sender, startup_rx)
bus --> sup : EventBusSender [broadcast cap=1024]
note right of sup : ✔ Phase 1 — EventBus prêt

' Phase 2
sup -> reg : AgentRegistry::spawn(event_sender)
reg --> sup : AgentRegistryHandle
note right of sup : ✔ Phase 2 — AgentRegistry prêt

' Phase 3
sup -> tools : ToolRegistryHandle::start()
tools --> sup : ToolRegistryHandle
sup -> tools : register(BashExecutor)
sup -> tools : register(FileIo)
sup -> tools : register(PythonExecutor)
note right of sup : ✔ Phase 3 — ToolRegistry prêt\n(3 outils natifs enregistrés)

' Phase 4 — optionnelle
alt [llm] configuré dans apollia.toml
  sup -> llm : LlmRouter::from_config_with_bus(\n  llm_config, event_sender\n)
  llm -> bus : send(LlmModelLoading { backend, model_path })

  alt EmbeddedBackend [feature=local]
    llm -> llm : load .gguf in-process
    alt fichier absent
      llm -> bus : send(LlmModelFailed { backend, reason })
      note right of llm : ⚠ warning — backend ignoré\nruntime continue
    else succès
      llm -> bus : send(LlmModelReady { backend, model_id })
    end
  else Cloud backend [feature=cloud]
    llm -> llm : vérifier api_key_env présent
    alt clé absente
      llm -> bus : send(LlmModelFailed { backend, reason })
      note right of llm : ⚠ warning — backend ignoré
    else clé présente
      llm -> bus : send(LlmModelReady { backend, model_id })
    end
  end

  llm --> sup : Ok(Arc<LlmRouter>)
  note right of sup : ✔ Phase 4 — LlmRouter prêt\n(N backends actifs)

else aucun [llm] dans apollia.toml
  note right of sup : ⚠ Phase 4 — LlmRouter absent\nctx.llm = None pour tous les agents
end

' Phase 5
sup -> router : TaskRouter::spawn(\n  registry_handle,\n  event_sender, cap=256\n)
router --> sup : TaskRouterHandle
note right of sup : ✔ Phase 5 — TaskRouter prêt

' Phase 6
sup -> api : APIServer::new(api_config, AppState {\n  registry, router, tools,\n  llm_router, agent_loader,\n  trigger_engine, notification_config\n})
api -> api : bind Unix socket\nbind TCP :7771
api --> sup : APIServerHandle
note right of sup : ✔ Phase 6 — APIServer prêt\n/tmp/apollia.sock · :7771

' Phase 7 — triggers depuis SQLite (Sprint 17, ADR-033)
sup -> sup : TriggerDefinitionRepository::open(\n  data_dir/triggers_def.db\n)
sup -> sup : charger définitions SQLite\n(defs invalides → warn!, skip)
sup -> trig : TriggerEngine::start(\n  defs_from_sqlite, event_sender\n)
trig -> trig : spawn sources\n(cron, interval, oneshot,\nfile_watch, webhook)
trig --> sup : TriggerEngineHandle
note right of sup : ✔ Phase 7 — TriggerEngine prêt\n(N triggers actifs)\nRepository → Arc<Mutex<>> dans AppState

' Phase 8 — optionnelle (Sprint 9 Dashboard, géré via APIServer)
note right of sup : ✔ Phase 8 — Dashboard HTMX\nembarqué dans APIServer\n(GET /dashboard)

' Phase 9 — notifications depuis SQLite (Sprint 17, ADR-033)
sup -> sup : NotificationConfigRepository::open(\n  data_dir/notifications.db\n)
alt canaux configurés dans SQLite
  sup -> notif : NotificationEngine::new(\n  config_from_sqlite, channels, event_sender\n)
  notif -> notif : build_channels()\n(desktop, webhook)
  notif -> bus : subscribe()
  note right of sup : ✔ Phase 9 — NotificationEngine prêt\n(M canaux actifs)\nRepository → Arc<Mutex<>> dans AppState
else base SQLite vide
  note right of sup : ⚠ Phase 9 — NotificationEngine absent\naucune notification envoyée
end

' AllReady
sup -> bus : send(RuntimeEvent::AllReady)
sup --> cli : SupervisorHandles { ... }
note over cli : ✔ Runtime prêt\napollia-os surveille\nSIGTERM / ShutdownRequested

@enduml
