@startuml component-sdk-architecture
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "JetBrains Mono"
skinparam defaultFontSize 12
skinparam ArrowColor #444444
skinparam BorderColor #444444
title [SDK Python Architecture] - Apollia OS

skinparam package {
  BackgroundColor #f8f8ff
  BorderColor #444444
}

skinparam component {
  BackgroundColor #1a1a2e
  FontColor #e0e0ff
  BorderColor #444444
}

package "sdk/apollia/" as sdk {
  component "types.py\nAIPResult" as types #2d4a22

  package "agents/" as agents {
    component "BaseReActAgent" as react #2d4a22
    component "ConversationalAgent" as conv #2d4a22
    component "OrchestratedAgent" as orch #2d4a22
  }

  package "utils/" as utils {
    component "parsing.py\nextract_json, truncate" as parsing #2a3a4a
    component "formatting.py\nformat_as_markdown" as formatting #2a3a4a
    component "hitl.py\nresume_pending_tool" as hitl #2a3a4a
  }

  package "tools/" as tools {
    component "schemas.py\nbuild_tools_block_from_ctx()\nrender_descriptor()\nNATIVE_TOOL_SCHEMAS (legacy fallback)" as schemas #2a3a4a
  }

  package "testing/" as testing {
    component "mocks.py\nMockContext" as mocks #4a3728
    component "assertions.py\nassert_result_*" as assertions #4a3728
  }

  package "stubs/" as stubs {
    component "context.pyi\ntools.pyi\nllm.pyi\nmemory.pyi" as pyi #3a3a3a
  }

  package "cli/" as cli {
    component "scaffold.py\napollia new" as scaffold #3a3a3a
  }
}

package "Runtime Rust (PyO3)" as runtime #1a1a2e {
  component "RuntimeContext" as ctx
  component "ToolProxy" as tp
  component "LlmProxy" as lp
  component "MemoryInterface" as mi
}

package "CLI Rust" as clirs #1a1a2e {
  component "apollia-os agent new" as clinew
}

package "Desktop (Tauri)" as desktop #1a1a2e {
  component "CreateFromTemplateDialog" as dialog
}

react --> types : retourne
conv --> types : retourne
orch --> types : retourne

react --> parsing : extract_json
react --> schemas : build_tools_block_from_ctx(ctx, ...)
schemas --> tp : ctx.tools.describe(name)\n(single source of truth)
react --> hitl : resume_pending_tool

mocks ..> pyi : implémente\nles interfaces
assertions --> mocks : vérifie

pyi ..> ctx : type stubs pour
pyi ..> tp : type stubs pour
pyi ..> lp : type stubs pour
pyi ..> mi : type stubs pour

clinew --> scaffold : délègue via\npython3 -m apollia
dialog --> scaffold : délègue via\npython3 -m apollia

@enduml
