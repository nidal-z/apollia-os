@startuml seq-task-lifecycle
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "JetBrains Mono"
skinparam defaultFontSize 11
skinparam ArrowColor #444444
skinparam BorderColor #444444
skinparam SequenceGroupBorderColor #888888

title Séquence - Task Lifecycle Complet - Apollia OS

actor "User / CLI" as user #3a3a3a/white
participant "APIServer\n(axum)" as api #1a1a2e/e0e0ff
participant "TaskRouter" as router #1a1a2e/e0e0ff
participant "AgentRegistry" as reg #1a1a2e/e0e0ff
participant "ExecutionCoord." as coord #1a1a2e/e0e0ff
participant "ORIA Engine" as oria #1a1a2e/e0e0ff
participant "Agent Python" as agent #2d4a22/d4edda
participant "ToolRegistry" as tools #1a1a2e/e0e0ff
participant "MemoryEngine" as mem #2a3a4a/cce5ff
participant "EventBus" as bus #2a3a4a/cce5ff

user -> api : POST /api/v1/tasks\n{agent_name, input}

api -> router : Submit(task)
router -> reg : GetByName("hello-agent")
reg --> router : AgentEntry{state: Active}

alt agent STOPPING ou STOPPED
  router --> api : SubmitError::Unavailable
  api --> user : 409 Conflict
end

router -> bus : Publish(TaskSubmitted)
router -> coord : submit_task(task)

coord -> bus : Publish(TaskStarted)

coord -> oria : execute_direct(task, ctx)

note over oria
  Observer.classify() → Direct
  StepBudget initialisé
  ResilienceLayer prêt
end note

oria -> agent : agent.run(task, ctx)

group Traitement agent (N étapes)
  agent -> tools : ctx.tools.call("file_io", input)
  tools -> tools : sandbox exec\n(unshare)
  tools --> agent : {files: [...]}

  agent -> mem : ctx.memory.search("query")
  mem -> mem : FTS5 MATCH query\nBM25 ranking
  mem --> agent : [{content, score}]

  agent -> mem : ctx.memory.record("épisode", importance=0.8)
  mem -> mem : INSERT episodic_memories\nUPDATE memory_fts
end

agent --> oria : AIPResult{status: completed, output: [...]}

oria --> coord : TaskCompleted
coord -> bus : Publish(TaskCompleted{task_id, output})

bus --> api : TaskCompleted event\n(SSE subscriber)
api --> user : SSE: data: {event: TaskCompleted}

user -> api : GET /api/v1/tasks/{id}
api --> user : 200 {status: completed, output: [...]}

@enduml
