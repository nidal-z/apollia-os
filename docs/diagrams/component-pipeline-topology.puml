@startuml component-pipeline-topology
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "JetBrains Mono"
skinparam defaultFontSize 12
skinparam ArrowColor #444444
skinparam BorderColor #666666
skinparam NodeBorderColor #444444
skinparam NodeBackgroundColor #f5f5f5

title Topologie d'un Pipeline — Fan-out / Fan-in / Fallback / Condition — Apollia OS

' ────────────────────────── LÉGENDE ──────────────────────────────────────────

legend top left
  <#1a1a2e,#e0e0ff> Step normal
  <#2a3a4a,#cce5ff> Step optionnel (condition)
  <#4a3728,#f5e6d3> Step fallback
  <#2d4a22,#d4edda> Step terminal
  ──────────────────
  ➜  depends_on (toujours)
  ⟿  condition (si true)
  ⤷  fallback_for (si échec)
endlegend

' ────────────────────────── LAYER 0 ──────────────────────────────────────────

package "Layer 0 — Indépendant" #eeeeee {
  node "ocr\n[ocr-agent]\ninput: {{trigger.payload}}" as OCR #1a1a2e/e0e0ff
}

' ────────────────────────── LAYER 1 ──────────────────────────────────────────

package "Layer 1 — Fan-out (parallèle)" #eeeeee {
  node "validation\n[validation-agent]\nif steps.ocr.output\n  contains 'PDF'" as VAL #2a3a4a/cce5ff
  node "extraction\n[extraction-agent]\ninput: {{steps.ocr.output}}" as EXT #1a1a2e/e0e0ff
}

' ────────────────────────── LAYER 1 FALLBACK ─────────────────────────────────

package "Layer 1 — Fallback" #fff8ee {
  node "validation-fallback\n[manual-review-agent]\non_failure de validation" as VALFB #4a3728/f5e6d3
}

' ────────────────────────── LAYER 2 ──────────────────────────────────────────

package "Layer 2 — Fan-in (join)" #eeeeee {
  node "comptabilisation\n[compta-agent]\n⏸ HITL approval\ninput: {{steps.validation.output}}\n  + {{steps.extraction.output}}" as COMPTA #1a1a2e/e0e0ff
}

' ────────────────────────── LAYER 3 ──────────────────────────────────────────

package "Layer 3 — Terminal" #eeeeee {
  node "archivage\n[archive-agent]\ninput: {{steps.comptabilisation.output}}" as ARCH #2d4a22/d4edda
}

' ────────────────────────── DÉCLENCHEUR ──────────────────────────────────────

node "Trigger\nFileWatch\n~/factures/" as TRIGGER #3a3a3a/ffffff

' ────────────────────────── FLÈCHES ──────────────────────────────────────────

TRIGGER -down-> OCR : trigger_payload = "facture.pdf"

OCR -down-> VAL : depends_on\n+ condition: contains "PDF"
OCR -down-> EXT : depends_on

VAL ..> VALFB : on_failure = fallback\n(activé si VAL échoue)

VAL -down-> COMPTA : depends_on (ou VALFB si fallback)
EXT -down-> COMPTA : depends_on

COMPTA -down-> ARCH : depends_on

' ────────────────────────── ANNOTATIONS ─────────────────────────────────────

note bottom of COMPTA
  ⏸ HITL : compta-agent peut suspendre
  le pipeline via input_required().
  L'utilisateur approuve ou rejette
  via : apollia-os task resume <id>
end note

note bottom of VALFB
  Inactif par défaut.
  Activé seulement si "validation"
  échoue (on_failure = fallback).
  Son output remplace celui de
  "validation" dans les templates.
end note

note right of VAL
  Skippé si :
  steps.ocr.output
  ne contient pas "PDF"
  (condition = false)
end note

@enduml
