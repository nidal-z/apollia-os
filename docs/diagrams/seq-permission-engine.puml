@startuml seq-permission-engine
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "JetBrains Mono"
skinparam defaultFontSize 11
skinparam ArrowColor #444444
skinparam BorderColor #444444
skinparam SequenceGroupBorderColor #888888

title Séquence - Moteur de Permissions 3 Couches - Apollia OS

participant "ToolRegistry\n(invoke)" as reg #1a1a2e/e0e0ff
participant "PermissionEngine\n(decide)" as engine #1a1a2e/e0e0ff
participant "InjectionDetector\n(couche 3 - priorité)" as inj #4a3728/f5e6d3
participant "SafeList\n(couche 1 - config)" as safe #1a1a2e/e0e0ff
participant "PrefixRuleEngine\n(couche 2 - SQLite)" as prefix #2a3a4a/cce5ff
participant "PermissionAuditLog\n(SQLite)" as audit #2a3a4a/cce5ff
participant "EventBus" as bus #2a3a4a/cce5ff

reg -> engine : decide("bash_executor",\n input: {"cmd":"git status"},\n manifest)

note over engine
  Principe de moindre privilège (OWASP ASVS V1.4) :
  SafeList vide par défaut - aucune commande
  auto-approuvée sans config explicite.
end note

== Couche 3 - InjectionDetector (priorité absolue) ==

engine -> inj : is_injection("git status")

note over inj
  Analyse structurelle (POSIX §2.6.3) :
  · $(...) et backtick - command substitution
  · >(...) - process substitution bash §3.5.6
  · | bash/sh/python - CWE-78
  · eval $VAR - ShellCheck SC2046
  Contexte de quoting respecté (single quote safe)
end note

inj --> engine : false (commande propre)

alt Injection détectée (ex: "git status; rm -rf /")
  inj --> engine : true
  engine -> audit : record("bash_executor",\n "git status; rm -rf /",\n AutoDeniedInjection)
  engine --> reg : AutoDeniedInjection { pattern: ";" }
  reg --> reg : Err(ToolError::PermissionDenied)
  note over reg
    Fin - pas de HITL, pas d'exécution.
    InjectionDetector a priorité sur tout.
  end note
end

== Couche 1 - SafeList (config opérateur) ==

engine -> safe : matches("bash_executor",\n Some("git status"))

note over safe
  Vide par défaut - l'opérateur configure
  explicitement ce qui est sûr.
  Ex: safe_commands = ["bash_executor(git status)"]
end note

alt SafeList match
  safe --> engine : true
  engine -> audit : record("bash_executor", "git status",\n AutoAllowedSafeList)
  engine --> reg : AutoAllowedSafeList
  reg -> reg : execute directement\n(zéro HITL)
else SafeList miss
  safe --> engine : false → couche 2
end

== Couche 2 - PrefixRuleEngine (SQLite) ==

engine -> prefix : check("bash_executor",\n Some("git status"))

note over prefix
  Règles persistées - créées par le bouton
  "Toujours autoriser" dans l'UI HITL desktop.
  Ex: règle "bash_executor(git:*)" Allow
end note

alt Règle Allow trouvée
  prefix --> engine : Some(Allow) { rule_id: 42 }
  engine -> audit : record("bash_executor", "git status",\n AutoAllowedPrefixRule { rule_id: 42 })
  engine --> reg : AutoAllowedPrefixRule { rule_id: 42 }
  reg -> reg : execute directement\n(zéro HITL)
else Règle Deny trouvée
  prefix --> engine : Some(Deny) { rule_id: 99 }
  engine -> audit : record("bash_executor", "git status",\n AutoDeniedPrefixRule)
  engine --> reg : AutoDeniedPrefixRule { rule_id: 99 }
  reg --> reg : Err(ToolError::PermissionDenied)
else Aucune règle applicable
  prefix --> engine : None
  engine -> audit : record("bash_executor", "git status",\n NeedsApproval)
  engine --> reg : NeedsApproval
end

== Fallback - NeedsApproval → HITL ==

reg -> bus : publish(RuntimeEvent::\nPermissionRequired {\n  tool_name: "bash_executor",\n  input: {"cmd": "git status"},\n  request_id: "req-xyz"\n})

note over bus
  Desktop : PermissionDispatcher.svelte
  route vers BashPermissionView.svelte
  → commande colorisée + 3 boutons :
    [Approuver] [Refuser] [Toujours autoriser]

  "Toujours autoriser" → PrefixRuleEngine.add_rule()
  → la prochaine occurrence sera AutoAllowedPrefixRule
end note

@enduml
