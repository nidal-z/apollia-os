@startuml seq-a2a-discovery-invoke
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "JetBrains Mono"
skinparam defaultFontSize 12
skinparam ArrowColor #444444
skinparam BorderColor #444444
title Séquence A2A — Discovery & Invocation (Happy Path) — Apollia OS

participant "Director Agent\n(ORIA ReAct)" as director #2d4a22
participant "RuntimeContext\n(PyO3)" as ctx #1a1a2e
participant "A2AInvoker" as invoker #1a1a2e
participant "SkillIndex" as skills #1a1a2e
participant "TaskRouter" as router #1a1a2e
participant "EventBus" as bus #2a3a4a
participant "Worker Agent\n(excel-worker)" as worker #2d4a22

== 1. Delegation Request ==

director -> ctx : ctx.delegate("read-excel", payload)
note right of director #d4edda
  Director decides to delegate
  a sub-task to a specialist
  worker agent via A2A
end note

ctx -> invoker : route to A2AInvoker\n(skill_id="read-excel", payload)

== 2. Skill Discovery ==

invoker -> skills : resolve("read-excel")
skills --> invoker : found: excel-worker (Active)
note right of skills #cce5ff
  SkillIndex maps skill_id
  to agent_id + verifies
  ProcessState == ACTIVE
end note

== 3. Build A2A Context ==

invoker -> invoker : build A2AContext {\n  caller: "director",\n  skill_id: "read-excel",\n  user_memory_read_only: true,\n  timeout: configured\n}

== 4. Event — Invocation Started ==

invoker -> bus : emit A2AInvocationStarted {\n  caller: "director",\n  target: "excel-worker",\n  skill_id: "read-excel"\n}

== 5. Delegate to TaskRouter ==

invoker -> router : delegate(excel-worker,\npayload, a2a_context,\ntimeout)
router -> worker : dispatch task\nwith A2A context

== 6. Worker Execution ==

worker -> worker : receive task
worker -> worker : ReAct loop:\n  LLM → tool calls → result
note right of worker #d4edda
  Worker executes its
  SYSTEM_PROMPT-driven
  ReAct loop with compiled
  expertise for Excel ops
end note

worker --> router : AIPResult.completed() {\n  output: "{parsed data}"\n}

== 7. Result Propagation ==

router --> invoker : A2AInvocationResult {\n  result: "{parsed data}",\n  agent_name: "excel-worker",\n  skill_id: "read-excel",\n  duration_ms: 1240\n}

== 8. Event — Invocation Completed ==

invoker -> bus : emit A2AInvocationCompleted {\n  caller: "director",\n  target: "excel-worker",\n  skill_id: "read-excel",\n  duration_ms: 1240,\n  success: true\n}

== 9. Formatted Result to Director ==

invoker --> ctx : formatted result
ctx --> director : "[read-excel via excel-worker]\n{parsed data}"
note right of director #d4edda
  Director receives the result
  as a formatted string and
  continues its own ReAct loop
end note

@enduml
