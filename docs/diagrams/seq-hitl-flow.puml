@startuml seq-hitl-flow
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "JetBrains Mono"
skinparam defaultFontSize 11
skinparam ArrowColor #444444
skinparam BorderColor #444444
skinparam SequenceGroupBorderColor #888888

title Séquence — HITL Flow complet (approve / reject) — Apollia OS

actor "User / CLI" as user #3a3a3a/white
participant "APIServer\n(axum)" as api #1a1a2e/e0e0ff
participant "ORIA Engine\n(Mode Direct)" as oria #1a1a2e/e0e0ff
participant "Agent Python" as agent #2d4a22/d4edda
participant "TaskRepository\n(SQLite)" as repo #2a3a4a/cce5ff
participant "EventBus" as bus #2a3a4a/cce5ff
participant "NotificationEngine" as notif #4a3728/f5e6d3
participant "ResumeHandler" as resume #1a1a2e/e0e0ff

== Phase 1 — Exécution normale ==

user -> api : POST /api/v1/tasks\n{agent_name, input}
api -> oria : execute_direct(task, ctx)
oria -> agent : agent.run(task, ctx)\n(is_resumed=False)

note right of agent
  L'agent effectue ses steps,
  arrive à une décision qui
  nécessite validation humaine.
end note

== Phase 2 — Suspension HITL ==

agent --> oria : AIPResult {\n  status: InputRequired,\n  prompt: "Confirmer l'envoi ?",\n  context: {amount: 5100}\n}

oria -> repo : save_input_required(\n  task_id, step_id=None,\n  prompt, context\n)
repo --> oria : Ok

oria -> bus : publish(TaskInputRequired {\n  task_id, prompt, step_id: None\n})
oria -> oria : oneshot::channel() → (tx, rx)\nPendingApprovals.register(task_id, tx)\ntask_status → input_required

note right of oria
  ORIA se bloque sur rx.await.
  StepBudget est suspendu
  (pas de tick pendant l'attente).
end note

== Phase 3 — Notification ==

bus -> notif : TaskInputRequired event
notif -> notif : map_event() → Notification {\n  event: "task.input_required",\n  message: "Confirmer l'envoi ?",\n  severity: Warning\n}

group Canal Desktop (si activé)
  notif -> notif : DesktopChannel.send()\n→ notify-rust popup\n+ actions Approuver / Rejeter / Inspecter
end

group Canal Webhook (si configuré)
  notif -> notif : WebhookChannel.send()\nPOST https://hooks.example.com\n{event, task_id, message, resume_url}
end

== Phase 4a — Approbation ==

user -> api : POST /api/v1/tasks/{id}/resume\n{ approved: true, reason: null }

api -> resume : resume_task(task_id, body)
resume -> repo : get_task_status(task_id)\n→ "input_required" ✔
resume -> repo : save_input_response(\n  task_id, approved=true, reason=null\n)
resume -> bus : publish(TaskResumed {\n  task_id, approved: true\n})
resume -> oria : PendingApprovals.resolve(\n  task_id,\n  InputResponseData { approved: true }\n)
resume --> api : 200 { task_id, approved: true, status: "working" }
api --> user : 200 OK

oria -> repo : rebuild_for_resume(task_id)\n→ AIPTask {\n  is_resumed: true,\n  input_response: InputResponse {\n    approved: true, reason: None,\n    context: {amount: 5100},\n    responded_at: "..."\n  }\n}
oria -> bus : publish(TaskStarted { task_id })
oria -> agent : agent.run(task, ctx)\n(is_resumed=True)
agent --> oria : AIPResult { status: Completed, ... }
oria -> bus : publish(TaskCompleted { task_id, success: true })

== Phase 4b — Rejet (alternative) ==

alt Rejet
  user -> api : POST /api/v1/tasks/{id}/resume\n{ approved: false, reason: "Budget insuffisant" }
  api -> resume : resume_task(task_id, body)
  resume -> repo : save_input_response(\n  task_id, approved=false,\n  reason="Budget insuffisant"\n)
  resume -> bus : publish(TaskResumed {\n  task_id, approved: false\n})
  resume -> oria : PendingApprovals.resolve(\n  task_id,\n  InputResponseData { approved: false, reason: "..." }\n)
  oria --> oria : AIPResult::failed("REJECTED: Budget insuffisant")
  oria -> bus : publish(TaskCompleted { task_id, success: false })
end

== Phase 4c — Timeout (automatique) ==

alt Timeout (> input_required_timeout, défaut 24h)
  note over oria
    TimeoutWatcher scan toutes les 60s.
    Cherche les tâches input_required
    dont input_required_at > timeout.
  end note
  oria -> bus : publish(TaskApprovalTimeout { task_id })
  oria -> oria : PendingApprovals.cancel(task_id)\ntask_status → canceled
  oria -> bus : publish(TaskCompleted { task_id, success: false })
end

@enduml
