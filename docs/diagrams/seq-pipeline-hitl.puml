@startuml seq-pipeline-hitl
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "JetBrains Mono"
skinparam defaultFontSize 11
skinparam ArrowColor #444444
skinparam BorderColor #444444
skinparam SequenceGroupBorderColor #888888

title Séquence — HITL dans un Pipeline (suspend / resume) — Apollia OS

actor "User / CLI" as user #3a3a3a/white
participant "PipelineExecutor" as exec #1a1a2e/e0e0ff
participant "Agent Python\n(compta-agent)" as agent #2d4a22/d4edda
participant "ORIA Engine" as oria #1a1a2e/e0e0ff
participant "ResumeHandler" as resume #1a1a2e/e0e0ff
participant "PipelineRepository\n(SQLite)" as db #2a3a4a/cce5ff
participant "EventBus" as bus #2a3a4a/cce5ff
participant "NotificationEngine" as notif #4a3728/f5e6d3

== Phase 1 — Soumission normale du step ==

exec -> exec : Layer 2 — step "comptabilisation"\n→ all dépendances complétées ✔
exec -> exec : submit_task("compta-agent", input)
note right of exec
  PipelineExecutor s'abonne à l'EventBus
  AVANT de soumettre la tâche,
  pour ne pas rater TaskInputRequired
  si l'agent répond très vite.
  Pattern : subscribe → submit → await.
end note

exec -> bus : subscribe(filter: task_id="t-0023")

agent --> oria : AIPResult { status: InputRequired,\n  prompt: "Approuver le montant 12 500€ ?",\n  context: { invoice: "ACME-042" } }

oria -> bus : TaskInputRequired { task_id="t-0023", prompt, step_id: None }

== Phase 2 — Suspension du pipeline ==

exec <-- bus : TaskInputRequired { task_id="t-0023" }
note right of exec
  PipelineExecutor détecte InputRequired
  sur le task_id qu'il surveille.
end note

exec -> db : update_step("comptabilisation",\n  WaitingApproval, task_id="t-0023")
exec -> db : update_run(run_id, status=WaitingApproval {\n  step_id: "comptabilisation",\n  task_id: "t-0023"\n})
bus <-- exec : PipelineSuspended { run_id, step_id="comptabilisation",\n  task_id="t-0023" }

note over exec
  PipelineExecutor se bloque sur
  wait_for_resume(task_id).
  Il attend TaskResumed sur l'EventBus.
  Les steps suivants ne sont pas soumis.
end note

== Phase 3 — Notification ==

bus -> notif : PipelineSuspended event
notif -> notif : map_event() → Notification {\n  event: "pipeline.suspended",\n  message: "Pipeline suspendu : étape comptabilisation\n  attend approbation (facture ACME-042)",\n  severity: Warning\n}
notif -> user : 🔔 Desktop — Approuver / Rejeter / Inspecter

== Phase 4a — Approbation ==

user -> resume : POST /api/v1/tasks/t-0023/resume\n{ approved: true }
resume -> bus : TaskResumed { task_id="t-0023", approved: true }
resume --> user : 200 OK

exec <-- bus : TaskResumed { task_id="t-0023", approved: true }

exec -> db : update_step("comptabilisation", Running)
exec -> db : update_run(run_id, Running)
bus <-- exec : PipelineResumed { run_id, step_id="comptabilisation" }

note right of exec
  L'agent reprend avec is_resumed=True
  et input_response.approved=True.
  Le step continue son exécution.
end note

agent --> bus : TaskCompleted { task_id="t-0023", output="Enregistré #INV-2026-042" }
exec <-- bus : TaskCompleted
exec -> db : update_step("comptabilisation", Completed)
exec -> db : complete_run(run_id, Completed)
bus <-- exec : PipelineStepCompleted { step_id="comptabilisation" }
bus <-- exec : PipelineCompleted { run_id }

== Phase 4b — Rejet (alternative) ==

alt Rejet
  user -> resume : POST /api/v1/tasks/t-0023/resume\n{ approved: false, reason: "Montant incorrect" }
  resume -> bus : TaskResumed { approved: false }
  exec <-- bus

  note right of exec
    approved=false → le step est Failed.
    on_failure du step s'applique :
    - fail → pipeline Failed
    - skip → step Skipped, pipeline continue
    - fallback → step fallback activé
  end note

  exec -> db : update_step("comptabilisation", Failed,\n  error="REJECTED: Montant incorrect")

  alt on_failure = fail (défaut)
    exec -> db : fail_run(run_id, "comptabilisation", "REJECTED")
    bus <-- exec : PipelineFailed { run_id, step_id, reason }
  else on_failure = fallback
    exec -> exec : activate_fallback()\n→ recalcul topologique\n→ soumet step "compta-fallback"
  end
end

@enduml
