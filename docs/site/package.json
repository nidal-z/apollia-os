{
  "name": "apollia-docs-site",
  "version": "0.1.0",
  "private": true,
  "description": "Apollia OS adopters documentation (Docusaurus, Diataxis).",
  "license": "MIT OR Apache-2.0",
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus gen-api-docs all && docusaurus start",
    "build": "docusaurus gen-api-docs all && docusaurus build",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "gen-api": "docusaurus gen-api-docs all",
    "clean-api": "docusaurus clean-api-docs all",
    "write-translations": "docusaurus write-translations",
    "regen": "bash regen.sh"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.1",
    "@docusaurus/preset-classic": "3.10.1",
    "@docusaurus/theme-mermaid": "^3.10.1",
    "@mdx-js/react": "3.1.1",
    "clsx": "2.1.1",
    "docusaurus-plugin-openapi-docs": "5.1.0",
    "docusaurus-theme-openapi-docs": "5.1.0",
    "prism-react-renderer": "2.4.1",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.1",
    "@docusaurus/types": "3.10.1"
  },
  "engines": {
    "node": ">=18.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  }
}
