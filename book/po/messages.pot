msgstr ""

#: src/ops/config.md:268
msgid ""
"```toml\n"
"[stt]\n"
"# Activer le moteur STT\n"
"# Défaut : false\n"
"enabled = true\n"
"\n"
"# Chemin du modèle GGML Whisper\n"
"# Défaut : ~/.apollia/models/whisper-large-v3-fr-q5_0.bin\n"
