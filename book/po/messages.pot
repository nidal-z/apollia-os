"```toml\n"
"[[servers]]\n"
"name              = \"brave-search\"\n"
"command           = \"npx\"\n"
"args              = [\"-y\", \"@modelcontextprotocol/server-brave-search\"]\n"
"requires_approval = true\n"
"```"
