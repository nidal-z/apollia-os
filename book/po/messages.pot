msgstr ""

#: src/decisions/adr-030-eventbus-tauri-events-remplace-polling.md:94
msgid "Option retenue — EventBus → Tauri events"
msgstr ""

#: src/decisions/adr-030-eventbus-tauri-events-remplace-polling.md:97
msgid ""
"Latence quasi-nulle : l'event arrive dans le frontend en \\< 50ms après "
"émission Rust"
msgstr ""

#: src/decisions/adr-030-eventbus-tauri-events-remplace-polling.md:98
msgid "Aucune requête HTTP — communication in-process via le bridge Tauri natif"
msgstr ""

