"Contraintes :\n"
"- Maximum {max_steps} étapes\n"
"- Outils disponibles : {tool_names}\n"
"\n"
"Format JSON strict :\n"
"{\n"
"  \"steps\": [\n"
"    {\n"
"      \"step_id\": \"s1\",\n"
"      \"description\": \"...\",\n"
"      \"tool_hint\": \"file_io\",\n"
"      \"depends_on\": []\n"
"    }\n"
"  ]\n"
"}\n"
"\n"
"Tâche : {task_input}\n"
"```"
msgstr ""

