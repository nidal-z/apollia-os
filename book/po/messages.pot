"[llm]\n"
"default = \"local\"\n"
"\n"
"[[llm.backends]]\n"
"type         = \"embedded\"\n"
"name         = \"local\"\n"
"model_path   = \"~/.apollia/models/llama3.2-3B-q4_K_M.gguf\"\n"
"quantization = \"q4_k_m\"\n"
"device       = \"cpu\"    # remplacer par \"metal\" avec --features "
"local-metal sur Apple Silicon\n"
"\n"
"[llm.observability]\n"
"debug_log_prompt = true   # activer uniquement en dev\n"
"```"
