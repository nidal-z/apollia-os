{"name": "happy-read-default", "skill_id": "xlsx.read", "note": "Read fixture workbook with 2 sheets.", "payload": {"path": "${FX}/sample.xlsx"}, "expected": {"status": "completed", "schema_match": ["path", "read_mode", "sheets"]}}
{"name": "happy-read-with-types", "skill_id": "xlsx.read", "note": "Read with include_types=true returns typed cells.", "payload": {"path": "${FX}/sample.xlsx", "include_types": true}, "expected": {"status": "completed", "schema_match": ["sheets"]}}
{"name": "happy-read-formulas", "skill_id": "xlsx.read", "note": "Read in formulas mode returns formula strings.", "payload": {"path": "${FX}/with-formulas.xlsx", "read_mode": "formulas"}, "expected": {"status": "completed", "schema_match": ["sheets"]}}
{"name": "happy-read-filtered-sheet", "skill_id": "xlsx.read", "note": "Read only one sheet by name.", "payload": {"path": "${FX}/sample.xlsx", "sheet_names": ["Ventes"]}, "expected": {"status": "completed", "schema_match": ["sheets"]}}
{"name": "happy-read-as-dataframe", "skill_id": "xlsx.read-as-dataframe", "note": "Read workbook into pandas DataFrame.", "payload": {"path": "${FX}/sample.xlsx", "sheet_name": "Ventes"}, "expected": {"status": "completed", "schema_match": ["columns", "dtypes", "records", "rows_count"]}}
{"name": "happy-read-as-dataframe-with-hints", "skill_id": "xlsx.read-as-dataframe", "note": "Read DataFrame with dtypes_hint and nrows.", "payload": {"path": "${FX}/sample.xlsx", "sheet_name": "Ventes", "dtypes_hint": {"Produit": "str"}, "nrows": 2}, "expected": {"status": "completed", "schema_match": ["records", "rows_count"]}}
{"name": "happy-write-minimal", "skill_id": "xlsx.write", "note": "Write a single sheet with no styles.", "payload": {"output_path": "${FX}/out-minimal.xlsx", "sheets": [{"name": "Data", "headers": ["A", "B"], "rows": [[1, 2], [3, 4]]}]}, "expected": {"status": "completed", "schema_match": ["output_path", "sheets_count", "total_rows_written"]}}
{"name": "happy-write-with-styles", "skill_id": "xlsx.write", "note": "Write with named_styles + styles_apply + column_widths + freeze + auto_filter.", "payload": {"output_path": "${FX}/out-styled.xlsx", "named_styles": {"hdr": {"font": {"bold": true, "color": "FFFFFF"}, "fill": {"color": "1F4E78"}, "alignment": {"horizontal": "center"}}, "curr": {"number_format": "#,##0.00"}}, "sheets": [{"name": "Ventes", "headers": ["Date", "Produit", "Montant"], "rows": [["2026-05-18", "X", 1234.5], ["2026-05-19", "Y", 999.0]], "column_widths": {"A": 14, "B": 25, "C": 14}, "freeze": {"row": 1, "col": 0}, "auto_filter": true, "styles_apply": [{"range": "A1:C1", "style": "hdr"}, {"range": "C2:C1000", "style": "curr"}]}]}, "expected": {"status": "completed", "schema_match": ["output_path", "styles_applied_count"]}}
{"name": "happy-write-conditional-formatting", "skill_id": "xlsx.write", "note": "Write with a conditional_formatting rule greater_than.", "payload": {"output_path": "${FX}/out-cf.xlsx", "named_styles": {"hi": {"fill": {"color": "FFC7CE"}, "font": {"bold": true, "color": "9C0006"}}}, "sheets": [{"name": "Data", "headers": ["v"], "rows": [[10], [50], [100], [500]], "conditional_formatting": [{"range": "A2:A100", "rule": "greater_than", "value": 100, "style": "hi"}]}]}, "expected": {"status": "completed", "schema_match": ["conditional_rules_count"]}}
{"name": "happy-append-rows", "skill_id": "xlsx.append-rows", "note": "Append rows to existing workbook.", "payload": {"path": "${FX}/appendable.xlsx", "sheet_name": "Ventes", "rows": [["2026-05-19", "Z", 555.55]]}, "expected": {"status": "completed", "schema_match": ["path", "sheet_name", "rows_appended", "new_total_rows"]}}
{"name": "happy-update-cells", "skill_id": "xlsx.update-cells", "note": "Patch specific cells in an existing workbook.", "payload": {"path": "${FX}/updatable.xlsx", "sheet_name": "Ventes", "updates": [{"cell_ref": "B5", "value": "PATCHED"}, {"cell_ref": "C5", "value": 9999.99}]}, "expected": {"status": "completed", "schema_match": ["updated_count"]}}
{"name": "error-invalid-payload", "skill_id": "xlsx.read", "note": "Empty payload triggers INVALID_PAYLOAD.", "payload": {}, "expected": {"status": "failed", "code": "INVALID_PAYLOAD"}}
{"name": "error-missing-skill-id", "skill_id": null, "note": "No skill_id propagated triggers MISSING_SKILL_ID.", "payload": {"path": "${FX}/sample.xlsx"}, "expected": {"status": "failed", "code": "MISSING_SKILL_ID"}}
{"name": "error-unknown-skill-id", "skill_id": "xlsx.delete", "note": "Unknown skill_id triggers UNKNOWN_SKILL_ID.", "payload": {"path": "${FX}/sample.xlsx"}, "expected": {"status": "failed", "code": "UNKNOWN_SKILL_ID"}}
{"name": "error-file-not-found", "skill_id": "xlsx.read", "note": "Nonexistent path triggers FILE_NOT_FOUND.", "payload": {"path": "${FX}/nope.xlsx"}, "expected": {"status": "failed", "code": "FILE_NOT_FOUND"}}
{"name": "error-unsupported-format", "skill_id": "xlsx.read", "note": ".xlsm extension triggers UNSUPPORTED_FORMAT.", "payload": {"path": "${FX}/macros.xlsm"}, "expected": {"status": "failed", "code": "UNSUPPORTED_FORMAT"}}
{"name": "error-output-exists", "skill_id": "xlsx.write", "note": "Write without overwrite on existing file triggers OUTPUT_EXISTS.", "payload": {"output_path": "${FX}/sample.xlsx", "sheets": [{"name": "S", "rows": [[1]]}]}, "expected": {"status": "failed", "code": "OUTPUT_EXISTS"}}
{"name": "error-sheet-not-found", "skill_id": "xlsx.read", "note": "Unknown sheet_name triggers SHEET_NOT_FOUND.", "payload": {"path": "${FX}/sample.xlsx", "sheet_names": ["NopeSheet"]}, "expected": {"status": "failed", "code": "SHEET_NOT_FOUND"}}
{"name": "error-style-not-found", "skill_id": "xlsx.write", "note": "styles_apply references unknown style → STYLE_NOT_FOUND.", "payload": {"output_path": "${FX}/out-bad-style.xlsx", "named_styles": {"a": {"font": {"bold": true}}}, "sheets": [{"name": "S", "rows": [[1]], "styles_apply": [{"range": "A1", "style": "missing"}]}]}, "expected": {"status": "failed", "code": "STYLE_NOT_FOUND"}}
{"name": "error-invalid-style-color", "skill_id": "xlsx.write", "note": "Invalid hex color in named_styles triggers INVALID_STYLE.", "payload": {"output_path": "${FX}/out-bad-color.xlsx", "named_styles": {"bad": {"fill": {"color": "redish"}}}, "sheets": [{"name": "S", "rows": [[1]], "styles_apply": [{"range": "A1", "style": "bad"}]}]}, "expected": {"status": "failed", "code": "INVALID_STYLE"}}
