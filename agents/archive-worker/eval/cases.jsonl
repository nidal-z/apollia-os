{"name": "happy-list-zip", "skill_id": "archive.list", "note": "List a fresh zip containing 3 entries (text, binary, dir).", "payload": {"archive_path": "${FX}/sample.zip"}, "expected": {"status": "completed", "schema_match": ["entries", "total_entries", "format", "compressed_size", "uncompressed_size"]}}
{"name": "happy-list-targz", "skill_id": "archive.list", "note": "List a tar.gz to cover non-zip code path.", "payload": {"archive_path": "${FX}/sample.tar.gz"}, "expected": {"status": "completed", "schema_match": ["entries", "total_entries", "format"]}}
{"name": "happy-extract-zip", "skill_id": "archive.extract", "note": "Extract a zip into a tmp target dir.", "payload": {"archive_path": "${FX}/sample.zip", "target_dir": "${FX}/out-extract"}, "expected": {"status": "completed", "schema_match": ["extracted_count", "skipped_reasons", "total_uncompressed_bytes"]}}
{"name": "happy-extract-glob", "skill_id": "archive.extract", "note": "Extract with glob filter — only .txt entries kept.", "payload": {"archive_path": "${FX}/sample.zip", "target_dir": "${FX}/out-glob", "glob_filter": "*.txt"}, "expected": {"status": "completed", "schema_match": ["extracted_count"]}}
{"name": "happy-create-zip", "skill_id": "archive.create", "note": "Bundle two source files into a fresh zip.", "payload": {"output_path": "${FX}/created.zip", "archive_format": "zip", "sources": ["${FX}/src/a.txt", "${FX}/src/b.txt"]}, "expected": {"status": "completed", "schema_match": ["output_path", "entries_count", "compressed_size", "uncompressed_size"]}}
{"name": "happy-create-targz", "skill_id": "archive.create", "note": "Bundle a directory into a fresh tar.gz.", "payload": {"output_path": "${FX}/created.tar.gz", "archive_format": "tar.gz", "sources": ["${FX}/src"]}, "expected": {"status": "completed", "schema_match": ["output_path", "format"]}}
{"name": "happy-read-text", "skill_id": "archive.read-file", "note": "Read a UTF-8 text entry from a zip.", "payload": {"archive_path": "${FX}/sample.zip", "entry_path": "hello.txt", "mode": "text"}, "expected": {"status": "completed", "schema_match": ["content", "mode", "size_bytes", "truncated"]}}
{"name": "happy-read-binary", "skill_id": "archive.read-file", "note": "Read a binary entry as base64.", "payload": {"archive_path": "${FX}/sample.zip", "entry_path": "data/binary.bin", "mode": "binary"}, "expected": {"status": "completed", "schema_match": ["content_base64", "mode", "size_bytes"]}}
{"name": "error-missing-skill-id", "skill_id": null, "note": "No skill_id propagated triggers MISSING_SKILL_ID.", "payload": {"archive_path": "${FX}/sample.zip"}, "expected": {"status": "failed", "code": "MISSING_SKILL_ID"}}
{"name": "error-unknown-skill-id", "skill_id": "archive.bogus", "note": "Unknown skill_id triggers UNKNOWN_SKILL_ID.", "payload": {"archive_path": "${FX}/sample.zip"}, "expected": {"status": "failed", "code": "UNKNOWN_SKILL_ID"}}
{"name": "error-invalid-payload", "skill_id": "archive.list", "note": "Empty payload triggers INVALID_PAYLOAD.", "payload": {}, "expected": {"status": "failed", "code": "INVALID_PAYLOAD"}}
{"name": "error-file-not-found", "skill_id": "archive.list", "note": "Nonexistent archive_path triggers FILE_NOT_FOUND.", "payload": {"archive_path": "${FX}/nope.zip"}, "expected": {"status": "failed", "code": "FILE_NOT_FOUND"}}
{"name": "error-unsupported-format", "skill_id": "archive.list", "note": "Unrecognised extension (.rar) triggers UNSUPPORTED_FORMAT.", "payload": {"archive_path": "${FX}/sample.rar"}, "expected": {"status": "failed", "code": "UNSUPPORTED_FORMAT"}}
{"name": "error-entry-not-found", "skill_id": "archive.read-file", "note": "Reading a missing entry triggers ENTRY_NOT_FOUND.", "payload": {"archive_path": "${FX}/sample.zip", "entry_path": "nope.txt"}, "expected": {"status": "failed", "code": "ENTRY_NOT_FOUND"}}
{"name": "safety-path-traversal", "skill_id": "archive.extract", "note": "Entry '../escape.txt' must be skipped (path_traversal counter > 0).", "payload": {"archive_path": "${FX}/evil.zip", "target_dir": "${FX}/out-evil"}, "expected": {"status": "completed", "skipped_reasons_at_least": {"path_traversal": 1}}}
{"name": "safety-quota", "skill_id": "archive.extract", "note": "max_uncompressed_bytes=1 rejects all real entries (quota counter > 0).", "payload": {"archive_path": "${FX}/sample.zip", "target_dir": "${FX}/out-quota", "max_uncompressed_bytes": 1}, "expected": {"status": "completed", "skipped_reasons_at_least": {"quota": 1}}}
