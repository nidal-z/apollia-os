{"name": "happy-read-text-default", "skill_id": "pdf.read-text", "note": "Read text from fixture PDF (3 pages).", "payload": {"path": "${FX}/sample.pdf"}, "expected": {"status": "completed", "schema_match": ["path", "total_pages", "pages", "metadata"]}}
{"name": "happy-read-text-page-range", "skill_id": "pdf.read-text", "note": "Read only pages 1-2 of fixture.", "payload": {"path": "${FX}/sample.pdf", "page_range": "1-2"}, "expected": {"status": "completed", "schema_match": ["pages"]}}
{"name": "happy-read-text-no-metadata", "skill_id": "pdf.read-text", "note": "Read without metadata block.", "payload": {"path": "${FX}/sample.pdf", "include_metadata": false}, "expected": {"status": "completed", "schema_match": ["pages", "total_pages"]}}
{"name": "happy-read-tables", "skill_id": "pdf.read-tables", "note": "Extract tables from fixture PDF.", "payload": {"path": "${FX}/with-tables.pdf"}, "expected": {"status": "completed", "schema_match": ["path", "tables", "total_tables"]}}
{"name": "happy-read-tables-page-range", "skill_id": "pdf.read-tables", "note": "Restrict tables extraction to page 1.", "payload": {"path": "${FX}/with-tables.pdf", "page_range": "1"}, "expected": {"status": "completed", "schema_match": ["tables"]}}
{"name": "happy-read-forms-empty", "skill_id": "pdf.read-forms", "note": "Read forms on PDF without forms — returns empty list.", "payload": {"path": "${FX}/sample.pdf"}, "expected": {"status": "completed", "schema_match": ["path", "fields", "total_fields"]}}
{"name": "happy-render-md-simple", "skill_id": "pdf.render-from-markdown", "note": "Render minimal Markdown to PDF.", "payload": {"output_path": "${FX}/render-simple.pdf", "markdown": "# Hello\n\nThis is a test."}, "expected": {"status": "completed", "schema_match": ["output_path", "pages_count", "file_size_bytes"]}}
{"name": "happy-render-md-rich", "skill_id": "pdf.render-from-markdown", "note": "Render rich Markdown with headings, list, table, code block.", "payload": {"output_path": "${FX}/render-rich.pdf", "markdown": "# Rapport\n\n## Métriques\n\n| Métrique | Valeur |\n|---|---|\n| MRR | 12 000 € |\n| Churn | 2.1% |\n\n## Détails\n\n- Item **A** with *emphasis*\n- Item B with `code`\n- Item C\n\n```python\ndef hello():\n    print('Apollia')\n```\n\n> Note importante\n\n---\n\nVoir le [dashboard](https://example.com).\n", "title": "Rapport mensuel", "author": "Apollia"}, "expected": {"status": "completed", "schema_match": ["pages_count"]}}
{"name": "happy-render-md-landscape", "skill_id": "pdf.render-from-markdown", "note": "Render in landscape Legal format.", "payload": {"output_path": "${FX}/render-landscape.pdf", "markdown": "# Wide page\n\nLandscape Legal format.", "page_size": "Legal", "orientation": "landscape"}, "expected": {"status": "completed", "schema_match": ["pages_count"]}}
{"name": "happy-render-md-from-path", "skill_id": "pdf.render-from-markdown", "note": "Render from markdown_path (file).", "payload": {"output_path": "${FX}/render-frompath.pdf", "markdown_path": "${FX}/source.md"}, "expected": {"status": "completed", "schema_match": ["pages_count"]}}
{"name": "happy-merge-two", "skill_id": "pdf.merge", "note": "Merge 2 PDFs.", "payload": {"paths": ["${FX}/merge-a.pdf", "${FX}/merge-b.pdf"], "output_path": "${FX}/merged-ab.pdf"}, "expected": {"status": "completed", "schema_match": ["output_path", "merged_count", "total_pages", "file_size_bytes"]}}
{"name": "happy-merge-three-meta-1", "skill_id": "pdf.merge", "note": "Merge 3 PDFs with metadata from index 1.", "payload": {"paths": ["${FX}/merge-a.pdf", "${FX}/merge-b.pdf", "${FX}/merge-c.pdf"], "output_path": "${FX}/merged-abc.pdf", "metadata_from": 1}, "expected": {"status": "completed", "schema_match": ["merged_count", "total_pages"]}}
{"name": "happy-split-by-pages", "skill_id": "pdf.split", "note": "Split a multi-page PDF page-by-page (no ranges).", "payload": {"path": "${FX}/sample.pdf", "output_dir": "${FX}/split-by-page/"}, "expected": {"status": "completed", "schema_match": ["output_dir", "splits", "total_splits"]}}
{"name": "happy-split-named-ranges", "skill_id": "pdf.split", "note": "Split with named ranges.", "payload": {"path": "${FX}/sample.pdf", "output_dir": "${FX}/split-ranges/", "ranges": [{"name": "first", "pages": "1-2"}, {"name": "last", "pages": "3"}]}, "expected": {"status": "completed", "schema_match": ["splits"]}}
{"name": "error-invalid-payload", "skill_id": "pdf.read-text", "note": "Empty payload triggers INVALID_PAYLOAD.", "payload": {}, "expected": {"status": "failed", "code": "INVALID_PAYLOAD"}}
{"name": "error-missing-skill-id", "skill_id": null, "note": "No skill_id propagated triggers MISSING_SKILL_ID.", "payload": {"path": "${FX}/sample.pdf"}, "expected": {"status": "failed", "code": "MISSING_SKILL_ID"}}
{"name": "error-unknown-skill-id", "skill_id": "pdf.encrypt", "note": "Unknown skill_id triggers UNKNOWN_SKILL_ID.", "payload": {"path": "${FX}/sample.pdf"}, "expected": {"status": "failed", "code": "UNKNOWN_SKILL_ID"}}
{"name": "error-file-not-found", "skill_id": "pdf.read-text", "note": "Nonexistent path triggers FILE_NOT_FOUND.", "payload": {"path": "${FX}/nope.pdf"}, "expected": {"status": "failed", "code": "FILE_NOT_FOUND"}}
{"name": "error-unsupported-format", "skill_id": "pdf.read-text", "note": "Wrong extension triggers UNSUPPORTED_FORMAT.", "payload": {"path": "${FX}/sample.txt"}, "expected": {"status": "failed", "code": "UNSUPPORTED_FORMAT"}}
{"name": "error-invalid-page-range", "skill_id": "pdf.read-text", "note": "Bad page range syntax triggers INVALID_PAGE_RANGE.", "payload": {"path": "${FX}/sample.pdf", "page_range": "1-abc"}, "expected": {"status": "failed", "code": "INVALID_PAGE_RANGE"}}
{"name": "error-page-out-of-range", "skill_id": "pdf.read-text", "note": "Page > total_pages triggers PAGE_OUT_OF_RANGE.", "payload": {"path": "${FX}/sample.pdf", "page_range": "99"}, "expected": {"status": "failed", "code": "PAGE_OUT_OF_RANGE"}}
{"name": "error-output-exists", "skill_id": "pdf.merge", "note": "Merge with existing output + overwrite=false triggers OUTPUT_EXISTS.", "payload": {"paths": ["${FX}/merge-a.pdf", "${FX}/merge-b.pdf"], "output_path": "${FX}/sample.pdf"}, "expected": {"status": "failed", "code": "OUTPUT_EXISTS"}}
{"name": "error-merge-single-path", "skill_id": "pdf.merge", "note": "Merge with only 1 path triggers INVALID_DATA.", "payload": {"paths": ["${FX}/merge-a.pdf"], "output_path": "${FX}/merged-fail.pdf"}, "expected": {"status": "failed", "code": "INVALID_DATA"}}
{"name": "error-render-no-source", "skill_id": "pdf.render-from-markdown", "note": "render-from-markdown without markdown nor markdown_path triggers MISSING_FIELD.", "payload": {"output_path": "${FX}/render-nope.pdf"}, "expected": {"status": "failed", "code": "MISSING_FIELD"}}
{"name": "error-render-both-sources", "skill_id": "pdf.render-from-markdown", "note": "Both markdown AND markdown_path triggers INVALID_DATA.", "payload": {"output_path": "${FX}/render-nope.pdf", "markdown": "# x", "markdown_path": "${FX}/source.md"}, "expected": {"status": "failed", "code": "INVALID_DATA"}}
