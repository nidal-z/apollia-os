{"name": "happy-bar-vertical", "skill_id": "chart.bar", "note": "Vertical bar chart with categories and 2 series.", "payload": {"output_path": "${FX}/bar-v.png", "title": "Sales", "categories": ["Q1", "Q2", "Q3", "Q4"], "series": [{"name": "A", "data": [10, 20, 30, 40]}, {"name": "B", "data": [15, 25, 35, 45]}]}, "expected": {"status": "completed", "schema_match": ["output_path", "format", "data_points_count", "file_size_bytes"]}}
{"name": "happy-bar-horizontal-stacked", "skill_id": "chart.bar", "note": "Horizontal stacked bar with value_labels.", "payload": {"output_path": "${FX}/bar-h.svg", "categories": ["X", "Y", "Z"], "series": [{"name": "S1", "data": [5, 10, 15]}, {"name": "S2", "data": [3, 7, 11]}], "orientation": "horizontal", "bar_style": "stacked", "value_labels": true, "theme": "minimal"}, "expected": {"status": "completed", "schema_match": ["format", "data_points_count"]}}
{"name": "happy-line-number", "skill_id": "chart.line", "note": "Line chart with numeric x-axis and 2 series.", "payload": {"output_path": "${FX}/line-num.png", "title": "Numeric line", "series": [{"name": "y=x", "data": [{"x": 0, "y": 0}, {"x": 1, "y": 1}, {"x": 2, "y": 2}]}, {"name": "y=x^2", "data": [{"x": 0, "y": 0}, {"x": 1, "y": 1}, {"x": 2, "y": 4}]}]}, "expected": {"status": "completed", "schema_match": ["output_path", "data_points_count"]}}
{"name": "happy-line-datetime", "skill_id": "chart.line", "note": "Line chart with datetime ISO 8601 x-axis.", "payload": {"output_path": "${FX}/line-dt.png", "x_type": "datetime", "series": [{"name": "Traffic", "data": [{"x": "2026-01-01", "y": 100}, {"x": "2026-02-01", "y": 150}, {"x": "2026-03-01", "y": 220}], "marker": "o"}]}, "expected": {"status": "completed", "schema_match": ["data_points_count"]}}
{"name": "happy-line-dark-theme", "skill_id": "chart.line", "note": "Line chart with dark theme and area_fill.", "payload": {"output_path": "${FX}/line-dark.png", "theme": "dark", "area_fill": true, "series": [{"name": "v", "data": [{"x": 0, "y": 1}, {"x": 1, "y": 4}, {"x": 2, "y": 9}, {"x": 3, "y": 16}]}]}, "expected": {"status": "completed", "schema_match": ["output_path"]}}
{"name": "happy-pie-simple", "skill_id": "chart.pie", "note": "Simple pie chart with 3 slices.", "payload": {"output_path": "${FX}/pie-simple.png", "data": [{"label": "A", "value": 45}, {"label": "B", "value": 30}, {"label": "C", "value": 25}]}, "expected": {"status": "completed", "schema_match": ["output_path", "data_points_count"]}}
{"name": "happy-donut-explode", "skill_id": "chart.pie", "note": "Donut chart with hole + explode on first slice.", "payload": {"output_path": "${FX}/pie-donut.png", "donut": true, "hole_size": 0.4, "explode": [0.05, 0, 0], "data": [{"label": "X", "value": 50}, {"label": "Y", "value": 30}, {"label": "Z", "value": 20}]}, "expected": {"status": "completed", "schema_match": ["data_points_count"]}}
{"name": "happy-scatter-simple", "skill_id": "chart.scatter", "note": "Simple scatter without regression.", "payload": {"output_path": "${FX}/scatter.png", "series": [{"name": "pts", "data": [{"x": 1, "y": 2}, {"x": 3, "y": 5}, {"x": 5, "y": 9}, {"x": 7, "y": 14}]}]}, "expected": {"status": "completed", "schema_match": ["output_path", "data_points_count"]}}
{"name": "happy-scatter-regression", "skill_id": "chart.scatter", "note": "Scatter with linear regression + R² annotation.", "payload": {"output_path": "${FX}/scatter-reg.png", "regression": true, "series": [{"name": "y~x", "data": [{"x": 1, "y": 2.1}, {"x": 2, "y": 4.0}, {"x": 3, "y": 6.2}, {"x": 4, "y": 7.9}, {"x": 5, "y": 10.1}]}]}, "expected": {"status": "completed", "schema_match": ["data_points_count"]}}
{"name": "happy-scatter-bubble", "skill_id": "chart.scatter", "note": "Scatter with per-point sizes (bubble).", "payload": {"output_path": "${FX}/scatter-bubble.png", "series": [{"name": "weight", "data": [{"x": 1, "y": 1, "size": 50}, {"x": 2, "y": 2, "size": 200}, {"x": 3, "y": 3, "size": 500}]}]}, "expected": {"status": "completed", "schema_match": ["output_path"]}}
{"name": "happy-heatmap-viridis", "skill_id": "chart.heatmap", "note": "Heatmap with default viridis colormap and labels.", "payload": {"output_path": "${FX}/heat-v.png", "matrix": [[1, 2, 3], [4, 5, 6], [7, 8, 9]], "row_labels": ["r1", "r2", "r3"], "col_labels": ["c1", "c2", "c3"]}, "expected": {"status": "completed", "schema_match": ["output_path", "data_points_count"]}}
{"name": "happy-heatmap-rdbu-values", "skill_id": "chart.heatmap", "note": "Heatmap with RdBu colormap, vmin/vmax, show_values.", "payload": {"output_path": "${FX}/heat-rdbu.png", "matrix": [[1.0, 0.85, -0.32], [0.85, 1.0, -0.15], [-0.32, -0.15, 1.0]], "row_labels": ["A", "B", "C"], "col_labels": ["A", "B", "C"], "colormap": "RdBu", "vmin": -1, "vmax": 1, "show_values": true, "value_format": "{:.2f}"}, "expected": {"status": "completed", "schema_match": ["data_points_count"]}}
{"name": "happy-base64-mode", "skill_id": "chart.bar", "note": "Bar chart in base64 mode — no file written.", "payload": {"output_mode": "base64", "format": "png", "categories": ["A", "B"], "series": [{"name": "v", "data": [1, 2]}]}, "expected": {"status": "completed", "schema_match": ["content_base64", "format", "data_points_count"]}}
{"name": "happy-svg-output", "skill_id": "chart.pie", "note": "Pie chart in SVG format.", "payload": {"output_path": "${FX}/pie.svg", "data": [{"label": "A", "value": 1}, {"label": "B", "value": 1}]}, "expected": {"status": "completed", "schema_match": ["format"]}}
