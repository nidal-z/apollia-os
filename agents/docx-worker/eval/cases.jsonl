{"name": "happy-read-default", "skill_id": "docx.read", "note": "Read fixture document with headings + paragraphs + table + list.", "payload": {"path": "${FX}/sample.docx"}, "expected": {"status": "completed", "schema_match": ["path", "sections", "styles_used", "hyperlinks", "total_blocks"]}}
{"name": "happy-read-with-runs", "skill_id": "docx.read", "note": "Read with include_runs=true returns font details.", "payload": {"path": "${FX}/sample.docx", "include_runs": true}, "expected": {"status": "completed", "schema_match": ["sections", "total_blocks"]}}
{"name": "happy-read-hyperlinks", "skill_id": "docx.read", "note": "Read doc with a hyperlink — must surface it.", "payload": {"path": "${FX}/with-hyperlink.docx"}, "expected": {"status": "completed", "schema_match": ["hyperlinks"]}}
{"name": "happy-extract-tables", "skill_id": "docx.extract-tables", "note": "Extract tables from sample doc.", "payload": {"path": "${FX}/sample.docx"}, "expected": {"status": "completed", "schema_match": ["path", "tables", "total_tables"]}}
{"name": "happy-extract-tables-no-headers", "skill_id": "docx.extract-tables", "note": "Extract tables without headers detection.", "payload": {"path": "${FX}/sample.docx", "include_headers": false}, "expected": {"status": "completed", "schema_match": ["tables"]}}
{"name": "happy-write-minimal", "skill_id": "docx.write", "note": "Write a single section with one paragraph.", "payload": {"output_path": "${FX}/out-minimal.docx", "sections": [{"blocks": [{"type": "paragraph", "text": "Hello, Apollia."}]}]}, "expected": {"status": "completed", "schema_match": ["output_path", "sections_count", "blocks_count"]}}
{"name": "happy-write-with-styles", "skill_id": "docx.write", "note": "Write with named_styles, headings, table, list, paragraph styles.", "payload": {"output_path": "${FX}/out-styled.docx", "named_styles": {"title": {"font": {"size_pt": 18, "bold": true, "color": "1F4E78"}, "paragraph": {"alignment": "center", "space_after_pt": 12}}, "body": {"font": {"size_pt": 11}, "paragraph": {"alignment": "justify", "line_spacing": 1.15}}}, "sections": [{"blocks": [{"type": "heading", "text": "Titre 1", "level": 1, "style": "title"}, {"type": "paragraph", "text": "Corps justifié.", "style": "body"}, {"type": "table", "rows": [["A", "B"], ["1", "2"]]}, {"type": "list", "list_type": "bullet", "items": ["Item 1", "Item 2"]}]}]}, "expected": {"status": "completed", "schema_match": ["styles_applied_count", "blocks_count"]}}
{"name": "happy-write-with-table-borders", "skill_id": "docx.write", "note": "Write a table with borders + cell_shading.", "payload": {"output_path": "${FX}/out-table-borders.docx", "named_styles": {"hdr_table": {"table": {"borders": {"top": {"style": "single", "size_pt": 1.5, "color": "000000"}, "bottom": {"style": "single", "size_pt": 1.5, "color": "000000"}, "left": {"style": "single", "size_pt": 0.5, "color": "BFBFBF"}, "right": {"style": "single", "size_pt": 0.5, "color": "BFBFBF"}, "inside_h": {"style": "single", "size_pt": 0.5, "color": "BFBFBF"}, "inside_v": {"style": "single", "size_pt": 0.5, "color": "BFBFBF"}}, "cell_shading": {"color": "DDEBF7"}}}}, "sections": [{"blocks": [{"type": "table", "rows": [["H1", "H2"], ["a", "b"]], "style": "hdr_table"}]}]}, "expected": {"status": "completed", "schema_match": ["styles_applied_count"]}}
{"name": "happy-write-headers-footers", "skill_id": "docx.write", "note": "Write with headers and footers containing placeholders.", "payload": {"output_path": "${FX}/out-hf.docx", "sections": [{"header": {"left": "{date:%Y-%m-%d}", "center": "{filename}", "right": "Section {section_num}"}, "footer": {"right": "Page {page}/{total_pages}"}, "blocks": [{"type": "paragraph", "text": "Body."}]}]}, "expected": {"status": "completed", "schema_match": ["output_path"]}}
{"name": "happy-write-landscape", "skill_id": "docx.write", "note": "Write a landscape section.", "payload": {"output_path": "${FX}/out-landscape.docx", "document_setup": {"paper_size": "A4"}, "sections": [{"orientation": "landscape", "blocks": [{"type": "paragraph", "text": "Wide page content."}]}]}, "expected": {"status": "completed", "schema_match": ["sections_count"]}}
{"name": "happy-write-multi-section", "skill_id": "docx.write", "note": "Write 2 sections with different orientation.", "payload": {"output_path": "${FX}/out-multi.docx", "sections": [{"orientation": "portrait", "blocks": [{"type": "heading", "text": "Section 1", "level": 1}]}, {"orientation": "landscape", "blocks": [{"type": "heading", "text": "Section 2 (paysage)", "level": 1}]}]}, "expected": {"status": "completed", "schema_match": ["sections_count"]}}
{"name": "happy-append-section", "skill_id": "docx.append-section", "note": "Append blocks to existing document.", "payload": {"path": "${FX}/appendable.docx", "blocks": [{"type": "heading", "text": "Annexe ajoutée", "level": 2}, {"type": "paragraph", "text": "Contenu d'annexe."}]}, "expected": {"status": "completed", "schema_match": ["path", "blocks_appended"]}}
{"name": "happy-append-with-new-section", "skill_id": "docx.append-section", "note": "Append starting a new landscape section.", "payload": {"path": "${FX}/appendable2.docx", "section_break_before": true, "new_section_setup": {"orientation": "landscape"}, "blocks": [{"type": "heading", "text": "Annexe paysage", "level": 1}]}, "expected": {"status": "completed", "schema_match": ["new_section_started"]}}
{"name": "happy-render-template", "skill_id": "docx.render-from-template", "note": "Render a Jinja2 template with full context.", "payload": {"template_path": "${FX}/template.docx", "output_path": "${FX}/rendered.docx", "context": {"client_name": "Dupont SAS", "amount": 10000, "items": [{"label": "Mission A", "price": 5000}, {"label": "Mission B", "price": 5000}]}, "strict_undefined": true}, "expected": {"status": "completed", "schema_match": ["output_path", "template_path", "variables_used"]}}
{"name": "error-invalid-payload", "skill_id": "docx.read", "note": "Empty payload triggers INVALID_PAYLOAD.", "payload": {}, "expected": {"status": "failed", "code": "INVALID_PAYLOAD"}}
{"name": "error-missing-skill-id", "skill_id": null, "note": "No skill_id propagated triggers MISSING_SKILL_ID.", "payload": {"path": "${FX}/sample.docx"}, "expected": {"status": "failed", "code": "MISSING_SKILL_ID"}}
{"name": "error-unknown-skill-id", "skill_id": "docx.delete", "note": "Unknown skill_id triggers UNKNOWN_SKILL_ID.", "payload": {"path": "${FX}/sample.docx"}, "expected": {"status": "failed", "code": "UNKNOWN_SKILL_ID"}}
{"name": "error-file-not-found", "skill_id": "docx.read", "note": "Nonexistent path triggers FILE_NOT_FOUND.", "payload": {"path": "${FX}/nope.docx"}, "expected": {"status": "failed", "code": "FILE_NOT_FOUND"}}
{"name": "error-unsupported-format", "skill_id": "docx.read", "note": ".docm extension triggers UNSUPPORTED_FORMAT.", "payload": {"path": "${FX}/macros.docm"}, "expected": {"status": "failed", "code": "UNSUPPORTED_FORMAT"}}
{"name": "error-output-exists", "skill_id": "docx.write", "note": "Write without overwrite on existing file triggers OUTPUT_EXISTS.", "payload": {"output_path": "${FX}/sample.docx", "sections": [{"blocks": [{"type": "paragraph", "text": "x"}]}]}, "expected": {"status": "failed", "code": "OUTPUT_EXISTS"}}
{"name": "error-style-not-found", "skill_id": "docx.write", "note": "Block references unknown style → STYLE_NOT_FOUND.", "payload": {"output_path": "${FX}/out-bad-style.docx", "named_styles": {"a": {"font": {"bold": true}}}, "sections": [{"blocks": [{"type": "paragraph", "text": "x", "style": "missing"}]}]}, "expected": {"status": "failed", "code": "STYLE_NOT_FOUND"}}
{"name": "error-undefined-variables", "skill_id": "docx.render-from-template", "note": "Template has variables not in context, strict mode → UNDEFINED_VARIABLES.", "payload": {"template_path": "${FX}/template.docx", "output_path": "${FX}/render-fail.docx", "context": {"client_name": "Test"}, "strict_undefined": true}, "expected": {"status": "failed", "code": "UNDEFINED_VARIABLES"}}
