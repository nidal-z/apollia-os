# Settings read by the justfile. Copy this file to `.env` (untracked) and
# uncomment what you change: `just` loads it on every run. A variable exported
# in your shell wins over this file. Every value below is the default.

# ── Local model ──────────────────────────────────────────────────────────────
# GGUF model for the recipes that start a llama-server (llama-server,
# desktop-dev-llama, automation-seeded-llama, automation-real-llama,
# automation-first-run). No default: those recipes stop and say so without it.
# The model can also be passed as the recipe argument.
#APOLLIA_LLAMA_MODEL=/path/to/model.gguf

# llama-server binary. Empty: the one found on PATH.
#APOLLIA_LLAMA_BIN=

# Port the recipes start llama-server on.
#APOLLIA_LLAMA_PORT=8899

# Total context in tokens, split across the slots. Empty: 32768 for the dev
# recipes, 131072 for the automation recipes, whose model books need one slot
# to hold a whole prompt.
#APOLLIA_LLAMA_CTX=

# Parallel slots (`-np`). One slot gives a single conversation the whole context.
#APOLLIA_LLAMA_SLOTS=1

# Sampling temperature and seed. Empty: the server's own sampling for the dev
# recipes; 0 and 42 for the automation recipes, so two runs answer alike.
#APOLLIA_LLAMA_TEMP=
#APOLLIA_LLAMA_SEED=

# Extra llama-server flags, passed through verbatim. The daemon reads the same
# variable for the engine it starts itself.
#APOLLIA_LLAMA_EXTRA_ARGS=

# Log file of a llama-server started in the background.
#APOLLIA_LLAMA_LOG=/tmp/apollia-dev-llama-server.log

# ── Tests ────────────────────────────────────────────────────────────────────
# GGUF model for Track 3 of the CLI end-to-end suite (test-cli-model). No
# default: unset, Track 3 is skipped.
#APOLLIA_TEST_MODEL_GGUF=/path/to/model.gguf

# ── Desktop automaton ────────────────────────────────────────────────────────
# Where a run writes its captures and its report.json.
# Default: .apollia-automation at the repository root.
#APOLLIA_AUTOMATION_OUT=

# The throwaway HOME the seeded recipes rebuild on every run.
# Default: .apollia-seed-home at the repository root.
#APOLLIA_SEED_HOME=

# Narrative overlay for automation-screenshots, kept outside the repository.
# Default: ~/.apollia-seed-overlay. The assertion recipes never apply it.
#APOLLIA_SEED_OVERLAY=

# Allows the scripts that delete data to run. Read by the application itself.
#APOLLIA_AUTOMATION_ALLOW_DESTRUCTIVE=1
