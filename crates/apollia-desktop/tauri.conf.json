{
  "$schema": "https://raw.githubusercontent.com/nicegui-dev/tauri-v2-schema/main/tauri.conf.schema.json",
  "productName": "Apollia OS",
  "version": "0.1.0-1",
  "identifier": "com.apollia.desktop",
  "build": {
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "ui"
    },
    "beforeBuildCommand": {
      "script": "bash scripts/bundle-cli.sh",
      "cwd": "."
    },
    "beforeBundleCommand": {
      "script": "bash scripts/patch-prebundle-libpython.sh",
      "cwd": "."
    },
    "frontendDist": "ui/dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://localhost:5173 ws://localhost:5173; object-src 'none'; base-uri 'self'; frame-src 'none'"
    },
    "windows": [
      {
        "title": "Apollia OS",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "dmg",
      "app",
      "appimage",
      "deb",
      "msi",
      "nsis"
    ],
    "publisher": "Apollia",
    "homepage": "https://apollia.fr",
    "copyright": "Copyright (c) 2026 Nidal Zoumita",
    "license": "MIT OR Apache-2.0",
    "licenseFile": "../../packaging/windows/eula.rtf",
    "category": "DeveloperTool",
    "shortDescription": "Sovereign runtime for autonomous AI agents",
    "longDescription": "Apollia OS runs autonomous AI agents on your own machine. Local inference, local storage, local tools: nothing leaves the machine without an explicit action.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "apollia-os*",
      "runners/**/*",
      "python/**/*"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "libgomp1"
        ]
      }
    },
    "windows": {
      "wix": {
        "upgradeCode": "5a8d3ad7-989a-5c2e-8067-0377601091b3"
      },
      "nsis": {
        "languages": [
          "English",
          "French"
        ],
        "displayLanguageSelector": true,
        "installMode": "both"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Apollia-OS/apollia-os/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFDMDlEQ0Y5QkE5MjE4RTIKUldUaUdKSzYrZHdKcklnU0VSZVZyaWN4SDJlWm1GbjMxd29ZWGlSQlZKWEY3QkEvSXd2UjhmOTQK"
    }
  }
}
