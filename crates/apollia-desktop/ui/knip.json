{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/main.ts",
    "src/overlay.ts",
    "src/App.svelte",
    "src/routes/**/*.svelte",
    "scripts/*.mjs",
    "tests/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/lib/i18n/strings/index.ts",
    "src/lib/i18n/strings/*.ts"
  ],
  "project": [
    "src/**/*.{ts,svelte}",
    "scripts/**/*.{ts,mjs}",
    "tests/**/*.{ts,spec.ts}"
  ],
  "ignore": [
    "src/lib/components/**/index.ts"
  ],
  "ignoreDependencies": [
    "@types/dompurify"
  ],
  "ignoreExportsUsedInFile": true,
  "playwright": {
    "config": ["playwright.config.ts"],
    "entry": ["tests/**/*.spec.ts"]
  },
  "vitest": {
    "config": ["vitest.config.ts", "vite.config.ts"],
    "entry": ["src/**/*.test.ts"]
  }
}
